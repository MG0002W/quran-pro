{"code": 200, "status": "OK", "data": [{"number": 113, "name": "سُورَةُ الفَلَقِ", "englishName": "Al-Falaq", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "numberOfAyahs": 5, "ayahs": [{"number": 6226, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6227, "text": "مِن شَرِّ مَا خَلَقَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6228, "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6229, "text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6230, "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 113, "name": "سُورَةُ الفَلَقِ", "englishName": "Al-Falaq", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "numberOfAyahs": 5, "ayahs": [{"number": 6226, "text": "Скажи: «Прибегаю к защите Господа рассвета", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6227, "text": "от зла того, что Он сотворил,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6228, "text": "от зла мрака, когда он наступает,", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 604, "ruku": 555, "hizbQuarter": 240, "sajda": false}, {"number": 6229, "text": "от зла колдуний, попле