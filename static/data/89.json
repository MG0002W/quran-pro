{"code": 200, "status": "OK", "data": [{"number": 89, "name": "سُورَةُ الفَجۡرِ", "englishName": "Al-Fajr", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "numberOfAyahs": 30, "ayahs": [{"number": 5994, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5995, "text": "وَلَيَالٍ عَشْرٍۢ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5996, "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5997, "text": "وَٱلَّيْلِ إِذَا يَسْرِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5998, "text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5999, "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6000, "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6001, "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6002, "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6003, "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6004, "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6005, "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6006, "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6007, "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6008, "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6009, "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6010, "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6011, "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6012, "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6013, "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6014, "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6015, "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6016, "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6017, "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6018, "text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6019, "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6020, "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6021, "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6022, "text": "فَٱدْخُلِى فِى عِبَٰدِى", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6023, "text": "وَٱدْخُلِى جَنَّتِى", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 89, "name": "سُورَةُ الفَجۡرِ", "englishName": "Al-Fajr", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "numberOfAyahs": 30, "ayahs": [{"number": 5994, "text": "Клянусь зарею!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5995, "text": "Клянусь десятью ночами!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5996, "text": "Клянусь четом и нечетом!", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5997, "text": "Клянусь ночью, когда она проходит!", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5998, "text": "Неужели этих клятв не достаточно для обладающего разумом?", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5999, "text": "Неужели ты не видел, как Господь твой поступил с адитами -", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6000, "text": "народом Ирама, обладавшим колоннами (воздвигавшим высокие здания с колоннами или обладавшим могучим сложением и огромной силой),", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6001, "text": "подобных которому не было сотворено в городах?", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6002, "text": "С самудянами, рассекавшими скалы в лощине?", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6003, "text": "С Фараоном, владевшим кольями (обладавшим множеством воинов, которые поддерживали его власть, подобно тому, как колышки поддерживают шатер, или привязывавшим людей к кольям во время казни)?", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6004, "text": "Они преступали границы дозволенного на земле", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6005, "text": "и распространяли в них много нечестия.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6006, "text": "Тогда твой Господь пролил на них бич мучений.", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6007, "text": "Воистину, твой Господь - в засаде (предоставляет отсрочку грешникам, чтобы затем неожиданно наказать их за ослушание).", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6008, "text": "Когда Господь испытывает человека, оказывая ему милость и одаряя его благами, тот говорит: «Господь мой почтил меня!».", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6009, "text": "Когда же Он испытывает его, ограничивая его в пропитании, тот говорит: «Господь мой унизил меня!».", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6010, "text": "Но нет! Вы же сами не почитаете сироту,", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6011, "text": "не побуждаете друг друга кормить бедняка,", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6012, "text": "жадно (или целиком) пожираете наследство", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6013, "text": "и страстно любите богатство.", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6014, "text": "Но нет! Когда земля разобьется и превратится в песок.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6015, "text": "и твой Господь придет с ангелами, выстроившимися рядами,", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6016, "text": "в тот день приведут Геенну, и тогда человек помянет назидание. Но к чему такое поминание?", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6017, "text": "Он скажет: «Эх, если бы я заранее позаботился о своей жизни!».", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6018, "text": "В тот день никто не причинит таких мучений, как Он,", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6019, "text": "и никто не наложит таких оков, как Он.", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6020, "text": "О обретшая покой душа!", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6021, "text": "Вернись к своему Господу удовлетворенной и снискавшей довольство!", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6022, "text": "Войди в круг Моих рабов!", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6023, "text": "Войди в Мой Рай!", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 89, "name": "سُورَةُ الفَجۡرِ", "englishName": "Al-Fajr", "englishNameTranslation": "The Dawn", "revelationType": "Meccan", "numberOfAyahs": 30, "ayahs": [{"number": 5994, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5994.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5994.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5995, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5995.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5995.mp3"], "text": "وَلَيَالٍ عَشْرٍۢ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5996, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5996.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5996.mp3"], "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5997, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5997.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5997.mp3"], "text": "وَٱلَّيْلِ إِذَا يَسْرِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5998, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5998.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5998.mp3"], "text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 5999, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5999.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5999.mp3"], "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6000, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6000.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6000.mp3"], "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6001, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6001.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6001.mp3"], "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6002, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6002.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6002.mp3"], "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6003, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6003.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6003.mp3"], "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6004, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6004.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6004.mp3"], "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6005, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6005.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6005.mp3"], "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6006, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6006.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6006.mp3"], "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6007, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6007.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6007.mp3"], "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6008, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6008.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6008.mp3"], "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6009, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6009.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6009.mp3"], "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6010, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6010.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6010.mp3"], "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6011, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6011.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6011.mp3"], "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6012, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6012.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6012.mp3"], "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6013, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6013.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6013.mp3"], "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6014, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6014.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6014.mp3"], "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6015, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6015.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6015.mp3"], "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6016, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6016.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6016.mp3"], "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 593, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6017, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6017.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6017.mp3"], "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6018, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6018.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6018.mp3"], "text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6019, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6019.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6019.mp3"], "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6020, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6020.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6020.mp3"], "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6021, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6021.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6021.mp3"], "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6022, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6022.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6022.mp3"], "text": "فَٱدْخُلِى فِى عِبَٰدِى", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}, {"number": 6023, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6023.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6023.mp3"], "text": "وَٱدْخُلِى جَنَّتِى", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 594, "ruku": 531, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}