{"code": 200, "status": "OK", "data": [{"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6100, "text": "وَطُورِ سِينِينَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6101, "text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6102, "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6103, "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6104, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6105, "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6106, "text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "text": "Клянусь смоковницей и оливой!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6100, "text": "Клянусь горой Синин (Синай)!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6101, "text": "Клянусь этим безопасным городом (Меккой)!", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6102, "text": "Мы сотворили человека в прекраснейшем облике.", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6103, "text": "Потом Мы вернем его в нижайшее из низких (продлим ему жизнь настолько, что он превратится в дряхлого старика, или бросим его на самое дно Геенны),", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6104, "text": "за исключением тех, которые уверовали и совершали праведные деяния. Им уготована награда неиссякаемая.", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6105, "text": "Что же после этого заставляет тебя считать ложью воздаяние?", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}, {"number": 6106, "text": "Разве Аллах не является Наимудрейшим Судьей?", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 537, "hizbQuarter": 239, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 95, "name": "سُورَةُ التِّينِ", "englishName": "At-Tin", "englishNameTranslation": "The Fig", "revelationType": "Meccan", "numberOfAyahs": 8, "ayahs": [{"number": 6099, "audio": "https://cdn.islamic.network/quran/audio/128/ar.a