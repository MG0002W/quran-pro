{"code": 200, "status": "OK", "data": [{"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "text": "وَيَصْلَىٰ سَعِيرًا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5898, "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5899, "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5900, "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5901, "text": "وَٱلَّيْلِ وَمَا وَسَقَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5902, "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5903, "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5904, "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5905, "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": {"id": 14, "recommended": true, "obligatory": false}}, {"number": 5906, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5907, "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5908, "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5909, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "text": "Когда небо разверзнется", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "text": "и внемлет своему Господу, как ему надлежит,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "text": "когда земля будет распростерта,", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "text": "извергнет то, что в ней, и опустеет,", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "text": "и внемлет своему Господу, как ей надлежит...", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "text": "О человек! Ты стремишься к своему Господу и встретишься с Ним.", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "text": "Тот, кому его книга будет вручена в правую руку,", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "text": "получит легкий расчет", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "text": "и вернется к своей семье радостным.", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "text": "А тот, кому его книга будет вручена из-за спины,", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "text": "станет призывать погибель", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "text": "и войдет в Пламень.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "text": "Он радовался, находясь в кругу своей семьи,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5898, "text": "и полагал, что не вернется обратно.", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5899, "text": "Но нет! Господь его видел его.", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5900, "text": "Но нет! Клянусь вечерней зарею!", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5901, "text": "Клянусь ночью и тем, что она собирает!", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5902, "text": "Клянусь луной в полнолуние!", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5903, "text": "Вы переходите из одного состояния в другое.", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5904, "text": "Почему же они не веруют", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5905, "text": "и не падают ниц, когда им читают Коран?", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": {"id": 14, "recommended": true, "obligatory": false}}, {"number": 5906, "text": "Но неверующие считают это ложью,", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5907, "text": "Аллаху же лучше знать, что они хранят (какие добрые и злые деяния они совершают).", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5908, "text": "Обрадуй же их мучительными страданиями,", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5909, "text": "кроме тех, которые уверовали и совершали праведные деяния. Им уготована награда неиссякаемая.", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 84, "name": "سُورَةُ الانشِقَاقِ", "englishName": "Al-Inshiqaaq", "englishNameTranslation": "The Splitting Open", "revelationType": "Meccan", "numberOfAyahs": 25, "ayahs": [{"number": 5885, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5885.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5885.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5886, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5886.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5886.mp3"], "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5887, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5887.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5887.mp3"], "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5888, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5888.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5888.mp3"], "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5889, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5889.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5889.mp3"], "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5890, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5890.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5890.mp3"], "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5891, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5891.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5891.mp3"], "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5892, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5892.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5892.mp3"], "text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5893, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5893.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5893.mp3"], "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5894, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5894.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5894.mp3"], "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5895, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5895.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5895.mp3"], "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5896, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5896.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5896.mp3"], "text": "وَيَصْلَىٰ سَعِيرًا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 589, "ruku": 526, "hizbQuarter": 236, "sajda": false}, {"number": 5897, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5897.m