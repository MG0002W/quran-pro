{"code": 200, "status": "OK", "data": [{"number": 83, "name": "سُورَةُ المُطَفِّفِينَ", "englishName": "Al-Mutaffifin", "englishNameTranslation": "Defrauding", "revelationType": "Meccan", "numberOfAyahs": 36, "ayahs": [{"number": 5849, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5850, "text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5851, "text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5852, "text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5853, "text": "لِيَوْمٍ عَظِيمٍۢ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5854, "text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5855, "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5856, "text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5857, "text": "كِتَٰبٌۭ مَّرْقُومٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5858, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5859, "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5860, "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5861, "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5862, "text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5863, "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5864, "text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5865, "text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5866, "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5867, "text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5868, "text": "كِتَٰبٌۭ مَّرْقُومٌۭ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5869, "text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5870, "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5871, "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5872, "text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5873, "text": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5874, "text": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5875, "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5876, "text": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5877, "text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5878, "text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5879, "text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5880, "text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5881, "text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5882, "text": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5883, "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 589, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5884, "text": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 589, "ruku": 525, "hizbQuarter": 235, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 83, "name": "سُورَةُ المُطَفِّفِينَ", "englishName": "Al-Mutaffifin", "englishNameTranslation": "Defrauding", "revelationType": "Meccan", "numberOfAyahs": 36, "ayahs": [{"number": 5849, "text": "Горе обвешивающим,", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5850, "text": "которые требуют дать им сполна, когда люди отмеривают им,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5851, "text": "а когда сами мерят или взвешивают для других, то наносят им урон.", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5852, "text": "Разве не думают они, что будут воскрешены", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5853, "text": "в Великий день -", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5854, "text": "в тот день, когда люди предстанут перед Господом миров?", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5855, "text": "Но нет! Книга грешников находится в Сиджжине.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5856, "text": "Откуда ты мог знать, что такое Сиджжин?", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5857, "text": "Это - книга начертанная, в которой записаны все злодеяния дьяволов, неверующих и грешников (или скала под седьмой землей, под которой находится начертанная книга с деяниями грешников).", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5858, "text": "Горе в тот день тем, кто считает истину ложью,", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5859, "text": "кто считает ложью День воздаяния!", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5860, "text": "Его считает ложью только преступник и грешник.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5861, "text": "Когда ему читают Наши аяты, он говорит: «Это - легенды древних народов!».", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5862, "text": "Но нет! Напротив, их сердца окутаны тем, что они приобрели.", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5863, "text": "Но нет! В тот день они будут отделены от своего Господа завесой (не увидят Аллаха),", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5864, "text": "а потом они попадут в Ад,", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5865, "text": "после чего им скажут: «Вот то, что вы считали ложью».", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5866, "text": "Но нет! Книга благочестивых окажется в Иллийюне.", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5867, "text": "Откуда ты мог знать, что такое Иллийюн?", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5868, "text": "Это - книга начертанная, в которой записаны все добрые деяния праведников (или верховья Рая, где находится начертанная книга с деяниями праведников).", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5869, "text": "Ее видят (или о ней будут свидетельствовать) приближенные.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5870, "text": "Воистину, благочестивые окажутся в блаженстве", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5871, "text": "и будут на ложах созерцать райские блага.", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5872, "text": "На их лицах ты увидишь блеск благоденствия.", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5873, "text": "Их будут поить выдержанным запечатанным вином,", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5874, "text": "а печатью его будет мускус (оно запечатано мускусом или же последний глоток его будет иметь привкус мускуса). Пусть же ради этого состязаются состязающиеся!", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5875, "text": "Оно смешано с напитком из Таснима -", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5876, "text": "источника, из которого пьют приближенные.", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5877, "text": "Грешники смеялись над теми, которые уверовали.", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5878, "text": "Проходя мимо них, они подмигивали друг другу,", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5879, "text": "возвращаясь к своим семьям, они возвращались радостными (или),", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5880, "text": "а при виде их они говорили: «Воистину, эти впали в заблуждение».", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5881, "text": "А ведь они не были посланы к ним хранителями.", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5882, "text": "В тот день верующие будут смеяться над неверующими", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5883, "text": "и на ложах созерцать райские блага и то ужасное положение, в котором окажутся грешники.", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 589, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5884, "text": "Разве неверующие не получат воздаяние за то, что они совершали?", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 589, "ruku": 525, "hizbQuarter": 235, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 83, "name": "سُورَةُ المُطَفِّفِينَ", "englishName": "Al-Mutaffifin", "englishNameTranslation": "Defrauding", "revelationType": "Meccan", "numberOfAyahs": 36, "ayahs": [{"number": 5849, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5849.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5849.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5850, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5850.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5850.mp3"], "text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5851, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5851.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5851.mp3"], "text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5852, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5852.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5852.mp3"], "text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5853, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5853.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5853.mp3"], "text": "لِيَوْمٍ عَظِيمٍۢ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5854, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5854.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5854.mp3"], "text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 587, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5855, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5855.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5855.mp3"], "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5856, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5856.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5856.mp3"], "text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5857, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5857.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5857.mp3"], "text": "كِتَٰبٌۭ مَّرْقُومٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5858, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5858.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5858.mp3"], "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5859, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5859.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5859.mp3"], "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5860, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5860.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5860.mp3"], "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5861, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5861.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5861.mp3"], "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5862, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5862.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5862.mp3"], "text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5863, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5863.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5863.mp3"], "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5864, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5864.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5864.mp3"], "text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5865, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5865.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5865.mp3"], "text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5866, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5866.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5866.mp3"], "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5867, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5867.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5867.mp3"], "text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5868, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5868.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5868.mp3"], "text": "كِتَٰبٌۭ مَّرْقُومٌۭ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5869, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5869.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5869.mp3"], "text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5870, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5870.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5870.mp3"], "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5871, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5871.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5871.mp3"], "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5872, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5872.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5872.mp3"], "text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5873, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5873.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5873.mp3"], "text": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5874, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5874.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5874.mp3"], "text": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5875, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5875.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5875.mp3"], "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5876, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5876.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5876.mp3"], "text": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5877, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5877.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5877.mp3"], "text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5878, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5878.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5878.mp3"], "text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5879, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5879.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5879.mp3"], "text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5880, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5880.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5880.mp3"], "text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5881, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5881.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5881.mp3"], "text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 588, "ruku": 525, "hizbQuarter": 235, "sajda": false}, {"number": 5882, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5882.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5882.mp3"],