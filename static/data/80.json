{"code": 200, "status": "OK", "data": [{"number": 80, "name": "سُورَةُ عَبَسَ", "englishName": "Abasa", "englishNameTranslation": "He frowned", "revelationType": "Meccan", "numberOfAyahs": 42, "ayahs": [{"number": 5759, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5760, "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5761, "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5762, "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5763, "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5764, "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5765, "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5766, "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5767, "text": "وَهُوَ يَخْشَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5768, "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5769, "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5770, "text": "فَمَن شَآءَ ذَكَرَهُۥ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5771, "text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5772, "text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5773, "text": "بِأَيْدِى سَفَرَةٍۢ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5774, "text": "كِرَامٍۭ بَرَرَةٍۢ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5775, "text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5776, "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5777, "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5778, "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5779, "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5780, "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5781, "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5782, "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5783, "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5784, "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5785, "text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5786, "text": "وَعِنَبًۭا وَقَضْبًۭا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5787, "text": "وَزَيْتُونًۭا وَنَخْلًۭا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5788, "text": "وَحَدَآئِقَ غُلْبًۭا", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5789, "text": "وَفَٰكِهَةًۭ وَأَبًّۭا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5790, "text": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5791, "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5792, "text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5793, "text": "وَأُمِّهِۦ وَأَبِيهِ", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5794, "text": "وَصَٰحِبَتِهِۦ وَبَنِيهِ", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5795, "text": "لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5796, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5797, "text": "ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5798, "text": "وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5799, "text": "تَرْهَقُهَا قَتَرَةٌ", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5800, "text": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 80, "name": "سُورَةُ عَبَسَ", "englishName": "Abasa", "englishNameTranslation": "He frowned", "revelationType": "Meccan", "numberOfAyahs": 42, "ayahs": [{"number": 5759, "text": "Он нахмурился и отвернулся,", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5760, "text": "потому что к нему подошел слепой.", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5761, "text": "Откуда тебе знать? Возможно, он бы очистился", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5762, "text": "или помянул бы наставление, и поминание принесло бы ему пользу.", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5763, "text": "Тому, кто решил, что он ни в чем не нуждается,", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5764, "text": "ты уделяешь внимание,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5765, "text": "Что же будет тебе, если он не очистится?", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5766, "text": "А того, кто приходит к тебе со рвением", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5767, "text": "и страшится Аллаха,", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5768, "text": "ты оставляешь без внимания.", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5769, "text": "Но нет! Это есть Назидание,", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5770, "text": "и пусть помянет его всякий желающий.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5771, "text": "Оно записано в свитках почитаемых,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5772, "text": "вознесенных и очищенных,", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5773, "text": "в руках посланцев", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5774, "text": "благородных и покорных.", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5775, "text": "Да сгинет человек! Как же он неблагодарен!", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5776, "text": "Из чего Он сотворил его?", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5777, "text": "Он сотворил его из капли и соразмерил (или предопределил стадии его развития),", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5778, "text": "потом облегчил ему путь,", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5779, "text": "потом умертвил его и поместил в могилу.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5780, "text": "Потом, когда пожелает, Он воскресит его.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5781, "text": "Но нет! Он не выполняет того, что Он приказал ему.", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5782, "text": "Пусть посмотрит человек на свое пропитание!", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5783, "text": "Мы проливаем обильные ливни,", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5784, "text": "затем рассекаем землю трещинами", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5785, "text": "и взращиваем на ней зерна,", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5786, "text": "виноград и люцерну,", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5787, "text": "маслины и финиковые пальмы,", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5788, "text": "сады густые (или с могучими деревьями),", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5789, "text": "фрукты и травы", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5790, "text": "на пользу вам и вашей скотине.", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5791, "text": "Когда же раздастся Оглушительный глас,", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5792, "text": "в тот день человек бросит своего брата,", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5793, "text": "свою мать и своего отца,", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5794, "text": "свою жену и своих сыновей,", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5795, "text": "ибо у каждого человека своих забот будет сполна.", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5796, "text": "В тот день одни лица будут сиять,", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5797, "text": "смеяться и ликовать.", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5798, "text": "На других же лицах в тот день будет прах,", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5799, "text": "покрывающий их мраком.", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5800, "text": "Это будут неверующие грешники.", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 80, "name": "سُورَةُ عَبَسَ", "englishName": "Abasa", "englishNameTranslation": "He frowned", "revelationType": "Meccan", "numberOfAyahs": 42, "ayahs": [{"number": 5759, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5759.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5759.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5760, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5760.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5760.mp3"], "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5761, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5761.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5761.mp3"], "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5762, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5762.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5762.mp3"], "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5763, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5763.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5763.mp3"], "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5764, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5764.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5764.mp3"], "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5765, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5765.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5765.mp3"], "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5766, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5766.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5766.mp3"], "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5767, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5767.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5767.mp3"], "text": "وَهُوَ يَخْشَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5768, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5768.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5768.mp3"], "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5769, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5769.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5769.mp3"], "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5770, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5770.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5770.mp3"], "text": "فَمَن شَآءَ ذَكَرَهُۥ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5771, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5771.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5771.mp3"], "text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5772, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5772.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5772.mp3"], "text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5773, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5773.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5773.mp3"], "text": "بِأَيْدِى سَفَرَةٍۢ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5774, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5774.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5774.mp3"], "text": "كِرَامٍۭ بَرَرَةٍۢ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5775, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5775.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5775.mp3"], "text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5776, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5776.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5776.mp3"], "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5777, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5777.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5777.mp3"], "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5778, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5778.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5778.mp3"], "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5779, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5779.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5779.mp3"], "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5780, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5780.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5780.mp3"], "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5781, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5781.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5781.mp3"], "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5782, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5782.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5782.mp3"], "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5783, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5783.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5783.mp3"], "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5784, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5784.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5784.mp3"], "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5785, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5785.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5785.mp3"], "text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 585, "ruku": 522, "hizbQuarter": 234, "sajda": false}, {"number": 5786, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5786.mp3", "audioSe