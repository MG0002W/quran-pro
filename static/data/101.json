{"code": 200, "status": "OK", "data": [{"number": 101, "name": "سُورَةُ القَارِعَةِ", "englishName": "Al-Qaari'a", "englishNameTranslation": "The Calamity", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6158, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6159, "text": "مَا ٱلْقَارِعَةُ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6160, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6161, "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6162, "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6163, "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6164, "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6165, "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6166, "text": "فَأُمُّهُۥ هَاوِيَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6167, "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6168, "text": "نَارٌ حَامِيَةٌۢ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 101, "name": "سُورَةُ القَارِعَةِ", "englishName": "Al-Qaari'a", "englishNameTranslation": "The Calamity", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6158, "text": "Великое бедствие (День воскресения)!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6159, "text": "Что такое Великое бедствие (День воскресения)?", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6160, "text": "Откуда ты мог знать, что такое Великое бедствие (День воскресения)?", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6161, "text": "В тот день люди будут подобны рассеянным мотылькам,", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6162, "text": "а горы будут подобны расчесанной шерсти.", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6163, "text": "Тогда тот, чья чаша Весов окажется тяжелой,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6164, "text": "обретет приятную жизнь.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6165, "text": "Для того же, чья чаша Весов окажется легкой,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6166, "text": "матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой).", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6167, "text": "Откуда ты мог знать, что это такое?", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6168, "text": "Это - жаркий Огонь!", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 101, "name": "سُورَةُ القَارِعَةِ", "englishName": "Al-Qaari'a", "englishNameTranslation": "The Calamity", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6158, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6158.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6158.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6159, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6159.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6159.mp3"], "text": "مَا ٱلْقَارِعَةُ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6160, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6160.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6160.mp3"], "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6161, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6161.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6161.mp3"], "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6162, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6162.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6162.mp3"], "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6163, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6163.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6163.mp3"], "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6164, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6164.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6164.mp3"], "text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6165, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6165.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6165.mp3"], "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6166, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6166.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6166.mp3"], "text": "فَأُمُّهُۥ هَاوِيَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6167, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6167.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6167.mp3"], "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}, {"number": 6168, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6168.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6168.mp3"], "text": "نَارٌ حَامِيَةٌۢ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 600, "ruku": 543, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}