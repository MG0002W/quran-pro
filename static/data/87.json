{"code": 200, "status": "OK", "data": [{"number": 87, "name": "سُورَةُ الأَعۡلَىٰ", "englishName": "Al-A'laa", "englishNameTranslation": "The Most High", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5949, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5950, "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5951, "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5952, "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5953, "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5954, "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5955, "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5956, "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5957, "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5958, "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5959, "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5960, "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5961, "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5962, "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5963, "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5964, "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5965, "text": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5966, "text": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5967, "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 87, "name": "سُورَةُ الأَعۡلَىٰ", "englishName": "Al-A'laa", "englishNameTranslation": "The Most High", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5949, "text": "Славь имя Господа твоего Всевышнего,", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5950, "text": "Который сотворил все сущее и всему придал соразмерность,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5951, "text": "Который предопределил судьбу творений и указал путь,", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5952, "text": "Который взрастил пастбища,", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5953, "text": "а потом превратил их в темный сор.", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5954, "text": "Мы позволим тебе прочесть Коран, и ты не забудешь ничего,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5955, "text": "кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5956, "text": "Мы облегчим тебе путь к легчайшему.", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5957, "text": "Наставляй же людей, если напоминание принесет пользу.", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5958, "text": "Воспримет его тот, кто страшится,", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5959, "text": "и уклонится от него самый несчастный,", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5960, "text": "который войдет в Огонь величайший.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5961, "text": "Не умрет он там и не будет жить.", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5962, "text": "Преуспел тот, кто очистился,", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5963, "text": "поминал имя своего Господа и совершал намаз.", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5964, "text": "Но нет! Вы отдаете предпочтение мирской жизни,", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5965, "text": "хотя Последняя жизнь - лучше и дольше.", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5966, "text": "Воистину, это записано в первых свитках -", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5967, "text": "свитках Ибрахима (Авраама) и Мусы (Моисея).", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 87, "name": "سُورَةُ الأَعۡلَىٰ", "englishName": "Al-A'laa", "englishNameTranslation": "The Most High", "revelationType": "Meccan", "numberOfAyahs": 19, "ayahs": [{"number": 5949, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5949.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5949.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5950, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5950.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5950.mp3"], "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5951, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5951.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5951.mp3"], "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5952, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5952.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5952.mp3"], "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5953, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5953.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5953.mp3"], "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5954, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5954.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5954.mp3"], "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5955, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5955.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5955.mp3"], "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5956, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5956.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5956.mp3"], "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5957, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5957.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5957.mp3"], "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5958, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5958.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5958.mp3"], "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5959, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5959.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5959.mp3"], "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5960, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5960.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5960.mp3"], "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5961, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5961.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5961.mp3"], "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5962, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5962.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5962.mp3"], "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5963, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5963.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5963.mp3"], "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 591, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5964, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5964.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5964.mp3"], "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5965, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5965.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5965.mp3"], "text": "وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5966, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5966.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5966.mp3"], "text": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}, {"number": 5967, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5967.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5967.mp3"], "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 529, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}