{"code": 200, "status": "OK", "data": [{"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5924, "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5925, "text": "فَعَّالٌۭ لِّمَا يُرِيدُ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5926, "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5927, "text": "فِرْعَوْنَ وَثَمُودَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5928, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5929, "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5930, "text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5931, "text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "text": "Клянусь небом с созвездиями Зодиака!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "text": "Клянусь днем обещанным!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "text": "Клянусь свидетельствующим и засвидетельствованным!", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "text": "Да сгинут собравшиеся у рва -", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "text": "огненного, поддерживаемого растопкой!", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "text": "Вот они уселись возле него,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "text": "будучи свидетелями того, что творят с верующими.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "text": "Они вымещали им только за то, что те уверовали в Аллаха Могущественного, Достохвального,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "text": "Которому принадлежит власть над небесами и землей. Аллах же - Свидетель всякой вещи!", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "text": "Тем, которые подвергли искушению (или сожгли в огне) верующих мужчин и женщин и не раскаялись, уготованы мучения в Геенне, мучения от обжигающего Огня.", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "text": "Тем же, которые уверовали и совершали праведные деяния, уготованы Райские сады, в которых текут реки. Это - великое преуспеяние!", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "text": "Воистину, Хватка твоего Господа сурова!", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "text": "Воистину, Он начинает и повторяет (создает творение в первый раз и воссоздает его или начинает наказывать в этом мире и возобновляет наказание в Последней жизни).", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "text": "Он - Прощающий, Любящий (или Любимый),", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5924, "text": "Владыка Трона, Славный (или Владыка Трона славного).", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5925, "text": "Он вершит то, что пожелает.", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5926, "text": "Дошел ли до тебя рассказ о воинствах,", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5927, "text": "о Фараоне и самудянах?", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5928, "text": "Но неверующие считают это ложью,", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5929, "text": "Аллах же окружает их сзади.", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5930, "text": "Да, это - славный Коран", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5931, "text": "в Хранимой скрижали.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 85, "name": "سُورَةُ البُرُوجِ", "englishName": "Al-Burooj", "englishNameTranslation": "The Constellations", "revelationType": "Meccan", "numberOfAyahs": 22, "ayahs": [{"number": 5910, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5910.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5910.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5911, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5911.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5911.mp3"], "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5912, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5912.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5912.mp3"], "text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5913, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5913.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5913.mp3"], "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5914, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5914.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5914.mp3"], "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5915, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5915.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5915.mp3"], "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5916, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5916.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5916.mp3"], "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5917, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5917.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5917.mp3"], "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5918, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5918.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5918.mp3"], "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5919, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5919.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5919.mp3"], "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5920, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5920.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5920.mp3"], "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5921, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5921.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5921.mp3"], "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5922, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5922.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5922.mp3"], "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 590, "ruku": 527, "hizbQuarter": 236, "sajda": false}, {"number": 5923, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5923.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5923.mp3"], "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ", "numberInSurah":