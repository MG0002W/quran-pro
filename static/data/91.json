{"code": 200, "status": "OK", "data": [{"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "text": "وَلَا يَخَافُ عُقْبَٰهَا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "text": "Клянусь солнцем и его утренним сиянием!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "text": "Клянусь луной, когда она следует за ним!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "text": "Клянусь днем, когда он делает его (солнце) ясным!", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "text": "Клянусь ночью, когда она скрывает его (солнце)!", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "text": "Клянусь небом и Тем, Кто его воздвиг (или тем, как Он воздвиг его)!", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "text": "Клянусь землей и Тем, Кто ее распростер (или тем, как Он распростер ее)!", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "text": "Клянусь душой и Тем, Кто придал ей совершенный облик (или тем, как Он сделал ее облик совершенным)", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "text": "и внушил ей порочность ее и богобоязненность!", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "text": "Преуспел тот, кто очистил ее,", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "text": "и понес урон тот, кто скрыл ее (опорочил, облек в несправедливость).", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "text": "Самудяне сочли лжецом пророка Салиха из-за своего беззакония,", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "text": "и тогда самый несчастный из них вызвался убить верблюдицу.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "text": "Посланник Аллаха (Салих) сказал им: «Берегите верблюдицу и питье ее!».", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "text": "Они сочли его лжецом и подрезали ей поджилки, и за этот грех Господь их подверг их наказанию, которое было одинаковым для всех (или сровнял над ними землю).", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "text": "И не опасался Он последствий этого.", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 91, "name": "سُورَةُ الشَّمۡسِ", "englishName": "Ash-Shams", "englishNameTranslation": "The Sun", "revelationType": "Meccan", "numberOfAyahs": 15, "ayahs": [{"number": 6044, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6044.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6044.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6045, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6045.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6045.mp3"], "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6046, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6046.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6046.mp3"], "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6047, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6047.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6047.mp3"], "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6048, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6048.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6048.mp3"], "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6049, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6049.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6049.mp3"], "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6050, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6050.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6050.mp3"], "text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6051, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6051.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6051.mp3"], "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6052, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6052.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6052.mp3"], "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6053, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6053.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6053.mp3"], "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6054, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6054.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6054.mp3"], "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6055, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6055.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6055.mp3"], "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6056, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6056.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6056.mp3"], "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6057, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6057.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6057.mp3"], "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}, {"number": 6058, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6058.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6058.mp3"], "text": "وَلَا يَخَافُ عُقْبَٰهَا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 595, "ruku": 533, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}