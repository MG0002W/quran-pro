{"code": 200, "status": "OK", "data": [{"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "text": "عُذْرًا أَوْ نُذْرًا", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "text": "لِيَوْمِ ٱلْفَصْلِ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5646, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5647, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5648, "text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5649, "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5650, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5651, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5652, "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5653, "text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5654, "text": "إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5655, "text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5656, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5657, "text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5658, "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5659, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5660, "text": "هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5661, "text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5662, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5663, "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5664, "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5665, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5666, "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5667, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5668, "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5669, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5670, "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5671, "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5672, "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "text": "Клянусь посылаемыми с добром,", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "text": "несущимися быстро,", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "text": "распространяющими бурно,", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "text": "различающими твердо,", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "text": "и передающими Напоминание", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "text": "для оправдания или предостережения.", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "text": "Обещанное вам непременно сбудется.", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "text": "Когда погаснут звезды,", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "text": "когда расколется небо,", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "text": "когда развеются горы,", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "text": "когда посланникам будет установлен срок.", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "text": "До какого дня отсрочено?", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "text": "До Дня различения!", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "text": "Откуда ты мог знать, что такое День различения?", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "text": "Разве мы не погубили первые поколения?", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "text": "Вслед за ними Мы отправили последующие поколения.", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "text": "Так поступаем Мы с грешниками.", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "text": "Разве Мы не сотворили вас из презренной жидкости", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "text": "и не поместили ее в надежном месте", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "text": "до известного срока?", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "text": "Мы предопределили меру, и как прекрасно Мы предопределяем!", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5646, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5647, "text": "Разве Мы не сделали землю вместилищем", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5648, "text": "для живых и мертвых?", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5649, "text": "Разве Мы не воздвигли на ней незыблемые и высокие горы и не напоили вас пресной водой?", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5650, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5651, "text": "Ступайте к тому, что вы считали ложью!", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5652, "text": "Ступайте к тени с тремя разветвлениями.", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5653, "text": "Не прохладна она и от пламени не избавляет,", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5654, "text": "а он бросает искры, подобные замку,", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5655, "text": "который выглядит словно желтые верблюды.", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5656, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5657, "text": "В тот день они будут безмолвствовать,", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5658, "text": "и не будет им дозволено оправдываться.", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5659, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5660, "text": "Вот День различения! Мы собрали вас и тех, кто был прежде.", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5661, "text": "Если у вас есть какая-нибудь хитрость, то ухитритесь против Меня!", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5662, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5663, "text": "А богобоязненные, воистину, пребудут среди сеней и источников", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5664, "text": "и плодов, каких только пожелают.", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5665, "text": "Ешьте и пейте во здравие за то, что вы совершали!", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5666, "text": "Так Мы вознаграждаем творящих добро.", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5667, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5668, "text": "Вкушайте и наслаждайтесь недолго, ведь вы являетесь грешниками.", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5669, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5670, "text": "Когда им говорят: «Поклонитесь!». - они не кланяются.", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5671, "text": "Горе в тот день тем, кто считает истину ложью!", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}, {"number": 5672, "text": "В какой же рассказ после этого вы уверуете?", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 581, "ruku": 517, "hizbQuarter": 232, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 77, "name": "سُورَةُ المُرۡسَلَاتِ", "englishName": "Al-Mursalaat", "englishNameTranslation": "The Emissaries", "revelationType": "Meccan", "numberOfAyahs": 50, "ayahs": [{"number": 5623, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5623.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5623.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5624, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5624.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5624.mp3"], "text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5625, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5625.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5625.mp3"], "text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5626, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5626.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5626.mp3"], "text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5627, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5627.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5627.mp3"], "text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5628, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5628.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5628.mp3"], "text": "عُذْرًا أَوْ نُذْرًا", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5629, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5629.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5629.mp3"], "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5630, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5630.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5630.mp3"], "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5631, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5631.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5631.mp3"], "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5632, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5632.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5632.mp3"], "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5633, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5633.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5633.mp3"], "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5634, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5634.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5634.mp3"], "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5635, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5635.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5635.mp3"], "text": "لِيَوْمِ ٱلْفَصْلِ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5636, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5636.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5636.mp3"], "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5637, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5637.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5637.mp3"], "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5638, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5638.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5638.mp3"], "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5639, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5639.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5639.mp3"], "text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5640, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5640.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5640.mp3"], "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5641, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5641.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5641.mp3"], "text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 580, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5642, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5642.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5642.mp3"], "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5643, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5643.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5643.mp3"], "text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5644, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5644.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5644.mp3"], "text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}, {"number": 5645, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5645.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5645.mp3"], "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 581, "ruku": 516, "hizbQuarter": 232, "sajda": false}