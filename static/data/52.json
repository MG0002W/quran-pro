{"code": 200, "status": "OK", "data": [{"number": 52, "name": "سُورَةُ الطُّورِ", "englishName": "At-Tur", "englishNameTranslation": "The Mount", "revelationType": "Meccan", "numberOfAyahs": 49, "ayahs": [{"number": 4736, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلطُّورِ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4737, "text": "وَكِتَٰبٍۢ مَّسْطُورٍۢ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4738, "text": "فِى رَقٍّۢ مَّنشُورٍۢ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4739, "text": "وَٱلْبَيْتِ ٱلْمَعْمُورِ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4740, "text": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4741, "text": "وَٱلْبَحْرِ ٱلْمَسْجُورِ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4742, "text": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4743, "text": "مَّا لَهُۥ مِن دَافِعٍۢ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4744, "text": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4745, "text": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4746, "text": "فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4747, "text": "ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4748, "text": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4749, "text": "هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4750, "text": "أَفَسِحْرٌ هَٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4751, "text": "ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4752, "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَعِيمٍۢ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4753, "text": "فَٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4754, "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4755, "text": "مُتَّكِـِٔينَ عَلَىٰ سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4756, "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍۢ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌۭ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4757, "text": "وَأَمْدَدْنَٰهُم بِفَٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا يَشْتَهُونَ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4758, "text": "يَتَنَٰزَعُونَ فِيهَا كَأْسًۭا لَّا لَغْوٌۭ فِيهَا وَلَا تَأْثِيمٌۭ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4759, "text": "۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ مَّكْنُونٌۭ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4760, "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4761, "text": "قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4762, "text": "فَمَنَّ ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4763, "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4764, "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍۢ وَلَا مَجْنُونٍ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4765, "text": "أَمْ يَقُولُونَ شَاعِرٌۭ نَّتَرَبَّصُ بِهِۦ رَيْبَ ٱلْمَنُونِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4766, "text": "قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4767, "text": "أَمْ تَأْمُرُهُمْ أَحْلَٰمُهُم بِهَٰذَآ ۚ أَمْ هُمْ قَوْمٌۭ طَاغُونَ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4768, "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4769, "text": "فَلْيَأْتُوا۟ بِحَدِيثٍۢ مِّثْلِهِۦٓ إِن كَانُوا۟ صَٰدِقِينَ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4770, "text": "أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَٰلِقُونَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4771, "text": "أَمْ خَلَقُوا۟ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4772, "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4773, "text": "أَمْ لَهُمْ سُلَّمٌۭ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَٰنٍۢ مُّبِينٍ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4774, "text": "أَمْ لَهُ ٱلْبَنَٰتُ وَلَكُمُ ٱلْبَنُونَ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4775, "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4776, "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4777, "text": "أَمْ يُرِيدُونَ كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4778, "text": "أَمْ لَهُمْ إِلَٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4779, "text": "وَإِن يَرَوْا۟ كِسْفًۭا مِّنَ ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4780, "text": "فَذَرْهُمْ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4781, "text": "يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4782, "text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4783, "text": "وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4784, "text": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَٰرَ ٱلنُّجُومِ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 52, "name": "سُورَةُ الطُّورِ", "englishName": "At-Tur", "englishNameTranslation": "The Mount", "revelationType": "Meccan", "numberOfAyahs": 49, "ayahs": [{"number": 4736, "text": "Клянусь горой!", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4737, "text": "Клянусь Писанием, начертанным", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4738, "text": "на развернутой нежной коже!", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4739, "text": "Клянусь домом наполненным (храмом на седьмом небе)!", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4740, "text": "Клянусь кровлей возведенной!", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4741, "text": "Клянусь морем разожженным (или переполненным; или опустевшим; или перемешанным; или удерживаемым)!", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4742, "text": "Наказание твоего Господа непременно наступит,", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4743, "text": "и ничто не отвратит его.", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4744, "text": "В тот день небо содрогнется от колебаний,", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4745, "text": "а горы придут в движение.", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4746, "text": "Горе в тот день тем, кто считает истину ложью,", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4747, "text": "кто забавляется, предаваясь празднословию.", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4748, "text": "В тот день они будут нещадно ввергнуты в огонь Геенны.", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4749, "text": "Это - тот самый Огонь, который вы считали ложью.", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4750, "text": "Неужели это колдовство? Или же вы не видите?", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4751, "text": "Горите в нем! Вам все равно, будете вы терпеть или не станете проявлять терпения. Вам воздается только за то, что вы совершали.", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4752, "text": "Воистину, богобоязненные пребудут в Райских садах и блаженстве.", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4753, "text": "Они будут радоваться тому, чем их одарит их Господь. Господь их уберег их от мучений в Аду.", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4754, "text": "Ешьте и пейте во здравие за то, что вы совершали!", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4755, "text": "Они будут, прислонившись, возлежать на ложах, выстроенных в ряд, и Мы сочетаем их с черноокими, большеглазыми гуриями.", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4756, "text": "Мы воссоединим верующих с их потомками, которые последовали за ними в вере, и нисколько не умалим их деяний. Каждый человек является заложником того, что он приобрел.", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4757, "text": "Мы наделим их фруктами и мясом таким, какое они пожелают.", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4758, "text": "Они будут передавать друг другу чашу с вином, которое не принесет ни празднословия, ни греха.", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4759, "text": "Их будут обходить их юные слуги, подобные сокрытому жемчугу.", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4760, "text": "Они будут расспрашивать друг друга.", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4761, "text": "Они скажут: «Прежде, находясь в кругу своих семей, мы трепетали от страха.", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4762, "text": "Аллах же оказал нам милость и уберег нас от мучений знойного ветра (или мучений в Аду).", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4763, "text": "Мы взывали к Нему прежде. Воистину, Он - Добродетельный, Милосердный».", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4764, "text": "Напоминай же! По милости своего Господа ты не являешься ни прорицателем, ни одержимым.", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4765, "text": "Или же они говорят: «Он - поэт! Давайте же подождем, пока время не разберется с ним».", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4766, "text": "Скажи: «Ждите, и я подожду вместе с вами».", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4767, "text": "Неужели умы повелевают им такое? Или же они являются людьми преступными?", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4768, "text": "Или же они говорят: «Он выдумал его!». О нет! Просто они не веруют.", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4769, "text": "Пусть приведут подобное ему (Корану) повествование, если они говорят правду.", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4770, "text": "Неужели они были сотворены сами по себе (или просто так)? Или же они сами являются творцами?", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4771, "text": "Или же это они сотворили небеса и землю? О нет! Просто они лишены убежденности.", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4772, "text": "Неужели у них находятся сокровищницы твоего Господа? Или же они сами являются владыками?", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4773, "text": "Или же у них есть лестница, на которой они подслушивают разговоры ангелов? Пусть тот из них, кто подслушивал, приведет ясное доказательство.", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4774, "text": "Неужели у Него - дочери, а у вас - сыновья?", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4775, "text": "Или же ты просишь у них вознаграждения, и они обременены обязательствами?", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4776, "text": "Или же они владеют сокровенным и записывают его?", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4777, "text": "Или же они желают замыслить козни? Но ведь неверующие сами станут жертвой козней.", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4778, "text": "Или же у них есть другой бог наряду с Аллахом? Аллах пречист и далек от тех, кого они приобщают в сотоварищи!", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4779, "text": "Даже если они увидят куски неба падающими, они скажут: «Это скопились облака!».", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4780, "text": "Оставь же их, пока они не встретят тот день их, когда их постигнет погибель.", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4781, "text": "В тот день их козни не принесут им никакой пользы, и никто не поможет им.", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4782, "text": "Воистину, беззаконникам уготованы мучения и перед этим, но большинство их не знает этого.", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4783, "text": "Потерпи же до решения твоего Господа, ведь ты - у Нас на Глазах. Прославляй хвалой своего Господа, когда поднимаешься ото сна.", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4784, "text": "Среди ночи восхваляй Его и при исчезновении звезд.", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 52, "name": "سُورَةُ الطُّورِ", "englishName": "At-Tur", "englishNameTranslation": "The Mount", "revelationType": "Meccan", "numberOfAyahs": 49, "ayahs": [{"number": 4736, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4736.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4736.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلطُّورِ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4737, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4737.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4737.mp3"], "text": "وَكِتَٰبٍۢ مَّسْطُورٍۢ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4738, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4738.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4738.mp3"], "text": "فِى رَقٍّۢ مَّنشُورٍۢ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4739, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4739.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4739.mp3"], "text": "وَٱلْبَيْتِ ٱلْمَعْمُورِ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4740, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4740.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4740.mp3"], "text": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4741, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4741.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4741.mp3"], "text": "وَٱلْبَحْرِ ٱلْمَسْجُورِ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4742, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4742.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4742.mp3"], "text": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4743, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4743.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4743.mp3"], "text": "مَّا لَهُۥ مِن دَافِعٍۢ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4744, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4744.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4744.mp3"], "text": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4745, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4745.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4745.mp3"], "text": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4746, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4746.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4746.mp3"], "text": "فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4747, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4747.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4747.mp3"], "text": "ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4748, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4748.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4748.mp3"], "text": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4749, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4749.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4749.mp3"], "text": "هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 523, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4750, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4750.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4750.mp3"], "text": "أَفَسِحْرٌ هَٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4751, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4751.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4751.mp3"], "text": "ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4752, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4752.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4752.mp3"], "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَعِيمٍۢ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4753, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4753.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4753.mp3"], "text": "فَٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4754, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4754.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4754.mp3"], "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4755, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4755.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4755.mp3"], "text": "مُتَّكِـِٔينَ عَلَىٰ سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4756, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4756.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4756.mp3"], "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍۢ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌۭ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4757, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4757.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4757.mp3"], "text": "وَأَمْدَدْنَٰهُم بِفَٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا يَشْتَهُونَ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4758, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4758.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4758.mp3"], "text": "يَتَنَٰزَعُونَ فِيهَا كَأْسًۭا لَّا لَغْوٌۭ فِيهَا وَلَا تَأْثِيمٌۭ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 209, "sajda": false}, {"number": 4759, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4759.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4759.mp3"], "text": "۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ مَّكْنُونٌۭ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4760, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4760.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4760.mp3"], "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4761, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4761.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4761.mp3"], "text": "قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4762, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4762.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4762.mp3"], "text": "فَمَنَّ ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4763, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4763.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4763.mp3"], "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 524, "ruku": 458, "hizbQuarter": 210, "sajda": false}, {"number": 4764, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4764.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4764.mp3"], "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍۢ وَلَا مَجْنُونٍ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4765, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4765.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4765.mp3"], "text": "أَمْ يَقُولُونَ شَاعِرٌۭ نَّتَرَبَّصُ بِهِۦ رَيْبَ ٱلْمَنُونِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4766, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4766.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4766.mp3"], "text": "قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 524, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4767, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4767.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4767.mp3"], "text": "أَمْ تَأْمُرُهُمْ أَحْلَٰمُهُم بِهَٰذَآ ۚ أَمْ هُمْ قَوْمٌۭ طَاغُونَ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4768, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4768.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4768.mp3"], "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4769, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4769.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4769.mp3"], "text": "فَلْيَأْتُوا۟ بِحَدِيثٍۢ مِّثْلِهِۦٓ إِن كَانُوا۟ صَٰدِقِينَ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4770, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4770.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4770.mp3"], "text": "أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَٰلِقُونَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4771, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4771.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4771.mp3"], "text": "أَمْ خَلَقُوا۟ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4772, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4772.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4772.mp3"], "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4773, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4773.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4773.mp3"], "text": "أَمْ لَهُمْ سُلَّمٌۭ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَٰنٍۢ مُّبِينٍ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4774, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4774.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4774.mp3"], "text": "أَمْ لَهُ ٱلْبَنَٰتُ وَلَكُمُ ٱلْبَنُونَ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4775, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4775.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4775.mp3"], "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4776, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4776.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4776.mp3"], "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4777, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4777.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4777.mp3"], "text": "أَمْ يُرِيدُونَ كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4778, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4778.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4778.mp3"], "text": "أَمْ لَهُمْ إِلَٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4779, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4779.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4779.mp3"], "text": "وَإِن يَرَوْا۟ كِسْفًۭا مِّنَ ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4780, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4780.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4780.mp3"], "text": "فَذَرْهُمْ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4781, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4781.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4781.mp3"], "text": "يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4782, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4782.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4782.mp3"], "text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4783, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4783.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4783.mp3"], "text": "وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}, {"number": 4784, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4784.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4784.mp3"], "text": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَٰرَ ٱلنُّجُومِ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 525, "ruku": 459, "hizbQuarter": 210, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}