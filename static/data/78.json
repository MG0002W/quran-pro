{"code": 200, "status": "OK", "data": [{"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "text": "كَلَّا سَيَعْلَمُونَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "text": "وَٱلْجِبَالَ أَوْتَادًۭا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "text": "وَجَنَّٰتٍ أَلْفَافًا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "text": "لِّلطَّٰغِينَ مَـَٔابًۭا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "text": "جَزَآءًۭ وِفَاقًا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "text": "حَدَآئِقَ وَأَعْنَٰبًۭا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "text": "وَكَوَاعِبَ أَتْرَابًۭا", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "text": "وَكَأْسًۭا دِهَاقًۭا", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "text": "О чем они расспрашивают друг друга?", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "text": "О великой вести,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "text": "относительно которой они расходятся во мнениях.", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "text": "Но нет, они узнают!", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "text": "Еще раз нет, они узнают!", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "text": "Разве Мы не сделали землю ложем,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "text": "а горы - колышками?", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "text": "Мы сотворили вас парами,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "text": "и сделали ваш сон отдыхом,", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "text": "и сделали ночь покрывалом,", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "text": "и сделали день жалованием,", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "text": "и воздвигли над вами семь твердынь,", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "text": "и установили пылающий светильник,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "text": "и низвели из облаков обильно льющуюся воду,", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "text": "чтобы взрастить ею зерна и растения", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "text": "и густые сады.", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "text": "Воистину, День различения назначен на определенное время.", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "text": "В тот день затрубят в Рог, и вы придете толпами,", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "text": "и небо раскроется и станет вратами,", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "text": "и горы придут в движение и станут маревом.", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "text": "Воистину, Геенна является засадой", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "text": "и местом возвращения для тех, кто преступает границы дозволенного.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "text": "Они пробудут там долгие годы,", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "text": "не вкушая ни прохлады, ни питья,", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "text": "а только кипяток и гной.", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "text": "Это будет подобающим возмездием.", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "text": "Воистину, они не надеялись на расчет", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "text": "и полностью отрицали Наши знамения.", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "text": "Мы же всякую вещь подсчитали и записали.", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "text": "Вкушайте же! Мы не прибавим вам ничего, кроме мучений.", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "text": "Воистину, богобоязненных ожидает место спасения,", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "text": "Райские сады и виноградники,", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "text": "и полногрудые сверстницы,", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "text": "и полные чаши.", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "text": "Они не услышат там ни пустословия, ни лжи.", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "text": "Это будет воздаянием от твоего Господа и даром исчисленным (или щедрым, или достаточным),", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "text": "Господа небес и земли и того, что между ними, Милостивого, с Которым они не посмеют даже заговорить.", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "text": "В тот день, когда Дух (Джибрил) и ангелы станут рядами, не будет говорить никто, кроме тех, кому позволит Милостивый, и говорить они будут правду.", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "text": "Это будет истинный день, и всякий, кто пожелает, найдет способ вернуться к своему Господу.", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "text": "Мы предостерегли вас от наказания близкого. В тот день человек увидит, что уготовили его руки, а неверующий скажет: «Эх, если бы я был прахом!».", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 78, "name": "سُورَةُ النَّبَإِ", "englishName": "An-Naba", "englishNameTranslation": "The Announcement", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5673, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5673.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5673.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5674, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5674.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5674.mp3"], "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5675, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5675.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5675.mp3"], "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5676, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5676.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5676.mp3"], "text": "كَلَّا سَيَعْلَمُونَ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5677, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5677.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5677.mp3"], "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5678, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5678.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5678.mp3"], "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5679, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5679.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5679.mp3"], "text": "وَٱلْجِبَالَ أَوْتَادًۭا", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5680, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5680.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5680.mp3"], "text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5681, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5681.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5681.mp3"], "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5682, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5682.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5682.mp3"], "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5683, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5683.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5683.mp3"], "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5684, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5684.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5684.mp3"], "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5685, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5685.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5685.mp3"], "text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5686, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5686.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5686.mp3"], "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5687, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5687.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5687.mp3"], "text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5688, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5688.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5688.mp3"], "text": "وَجَنَّٰتٍ أَلْفَافًا", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5689, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5689.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5689.mp3"], "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5690, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5690.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5690.mp3"], "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5691, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5691.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5691.mp3"], "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5692, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5692.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5692.mp3"], "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5693, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5693.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5693.mp3"], "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5694, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5694.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5694.mp3"], "text": "لِّلطَّٰغِينَ مَـَٔابًۭا", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5695, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5695.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5695.mp3"], "text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5696, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5696.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5696.mp3"], "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5697, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5697.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5697.mp3"], "text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5698, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5698.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5698.mp3"], "text": "جَزَآءًۭ وِفَاقًا", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5699, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5699.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5699.mp3"], "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5700, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5700.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5700.mp3"], "text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5701, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5701.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5701.mp3"], "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5702, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5702.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5702.mp3"], "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 582, "ruku": 518, "hizbQuarter": 233, "sajda": false}, {"number": 5703, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5703.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5703.mp3"], "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5704, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5704.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5704.mp3"], "text": "حَدَآئِقَ وَأَعْنَٰبًۭا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5705, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5705.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5705.mp3"], "text": "وَكَوَاعِبَ أَتْرَابًۭا", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5706, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5706.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5706.mp3"], "text": "وَكَأْسًۭا دِهَاقًۭا", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5707, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5707.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5707.mp3"], "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا كِذَّٰبًۭا", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5708, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5708.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5708.mp3"], "text": "جَزَآءًۭ مِّن رَّبِّكَ عَطَآءً حِسَابًۭا", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5709, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5709.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5709.mp3"], "text": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5710, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5710.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5710.mp3"], "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5711, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5711.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5711.mp3"], "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}, {"number": 5712, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5712.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5712.mp3"], "text": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 583, "ruku": 519, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}