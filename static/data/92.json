{"code": 200, "status": "OK", "data": [{"number": 92, "name": "سُورَةُ اللَّيۡلِ", "englishName": "Al-Lail", "englishNameTranslation": "The Night", "revelationType": "Meccan", "numberOfAyahs": 21, "ayahs": [{"number": 6059, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6060, "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6061, "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6062, "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6063, "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6064, "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6065, "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6066, "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6067, "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6068, "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6069, "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6070, "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6071, "text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6072, "text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6073, "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6074, "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6075, "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6076, "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6077, "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6078, "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6079, "text": "وَلَسَوْفَ يَرْضَىٰ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 92, "name": "سُورَةُ اللَّيۡلِ", "englishName": "Al-Lail", "englishNameTranslation": "The Night", "revelationType": "Meccan", "numberOfAyahs": 21, "ayahs": [{"number": 6059, "text": "Клянусь ночью, когда она покрывает землю!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6060, "text": "Клянусь днем, когда он проясняется!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6061, "text": "Клянусь Тем, Кто создал мужчину и женщину!", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6062, "text": "Ваши стремления различны.", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6063, "text": "Тому, кто отдавал должное (или раздавал милостыню) и был богобоязнен,", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6064, "text": "кто признавал наилучшее (свидетельство единобожия или Рай),", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6065, "text": "Мы облегчим путь к легчайшему (к праведным деяниям).", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6066, "text": "А тому, кто был скуп и полагал, что ни в чем не нуждается,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6067, "text": "кто счел ложью наилучшее (свидетельство единобожия или Рай),", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6068, "text": "Мы облегчим путь к тягчайшему (к злу и наказанию).", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6069, "text": "Не спасет его достояние, когда он падет (в Геенну или погибнет).", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6070, "text": "Воистину, Нам надлежит вести прямым путем.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6071, "text": "Нам же принадлежат жизнь Последняя и первая.", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6072, "text": "Я предостерег вас от пылающего Огня.", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6073, "text": "Войдет в него только самый несчастный,", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6074, "text": "который считает истину ложью и отворачивается.", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6075, "text": "Отдален от него будет самый богобоязненный,", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6076, "text": "который раздает свое имущество, очищаясь,", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6077, "text": "и всякую милость возмещает сполна", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6078, "text": "только из стремления к Лику своего Всевышнего Господа.", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6079, "text": "И он непременно будет удовлетворен.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 92, "name": "سُورَةُ اللَّيۡلِ", "englishName": "Al-Lail", "englishNameTranslation": "The Night", "revelationType": "Meccan", "numberOfAyahs": 21, "ayahs": [{"number": 6059, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6059.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6059.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6060, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6060.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6060.mp3"], "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6061, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6061.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6061.mp3"], "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6062, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6062.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6062.mp3"], "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6063, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6063.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6063.mp3"], "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6064, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6064.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6064.mp3"], "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6065, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6065.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6065.mp3"], "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6066, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6066.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6066.mp3"], "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6067, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6067.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6067.mp3"], "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6068, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6068.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6068.mp3"], "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6069, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6069.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6069.mp3"], "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6070, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6070.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6070.mp3"], "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6071, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6071.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6071.mp3"], "text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6072, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6072.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6072.mp3"], "text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 595, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6073, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6073.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6073.mp3"], "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6074, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6074.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6074.mp3"], "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6075, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6075.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6075.mp3"], "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6076, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6076.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6076.mp3"], "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6077, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6077.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6077.mp3"], "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6078, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6078.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6078.mp3"], "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}, {"number": 6079, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6079.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6079.mp3"], "text": "وَلَسَوْفَ يَرْضَىٰ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 596, "ruku": 534, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}