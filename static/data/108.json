{"code": 200, "status": "OK", "data": [{"number": 108, "name": "سُورَةُ الكَوۡثَرِ", "englishName": "Al-Kawthar", "englishNameTranslation": "Abundance", "revelationType": "Meccan", "numberOfAyahs": 3, "ayahs": [{"number": 6205, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}, {"number": 6206, "text": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}, {"number": 6207, "text": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 108, "name": "سُورَةُ الكَوۡثَرِ", "englishName": "Al-Kawthar", "englishNameTranslation": "Abundance", "revelationType": "Meccan", "numberOfAyahs": 3, "ayahs": [{"number": 6205, "text": "Мы даровали тебе аль-Каусар (бесчисленные блага, в том числе одноименную реку в Раю).", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}, {"number": 6206, "text": "Посему совершай намаз ради своего Господа и закалывай жертву.", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}, {"number": 6207, "text": "Воистину, твой ненавистник сам окажется безвестным.", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 602, "ruku": 550, "hizbQuarter": 240, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 108, "name": "سُورَةُ الكَوۡثَرِ", "englishName": "Al-Kawthar", "englishNameTranslation": "Abundan