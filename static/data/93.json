رْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6090, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6090.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6090.mp3"], "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}