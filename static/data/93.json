{"code": 200, "status": "OK", "data": [{"number": 93, "name": "سُورَةُ الضُّحَىٰ", "englishName": "Ad-Dhuhaa", "englishNameTranslation": "The Morning Hours", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6080, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6081, "text": "وَٱلَّيْلِ إِذَا سَجَىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6082, "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6083, "text": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6084, "text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6085, "text": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6086, "text": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6087, "text": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6088, "text": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6089, "text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6090, "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 93, "name": "سُورَةُ الضُّحَىٰ", "englishName": "Ad-Dhuhaa", "englishNameTranslation": "The Morning Hours", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6080, "text": "Клянусь утром!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6081, "text": "Клянусь ночью, когда она успокаивается (или покрывается мраком)!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6082, "text": "Не покинул тебя твой Господь и не возненавидел.", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6083, "text": "Воистину, будущее для тебя лучше, чем настоящее.", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6084, "text": "Господь твой непременно одарит тебя, и ты будешь удовлетворен.", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6085, "text": "Разве Он не нашел тебя сиротой и не дал тебе приют?", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6086, "text": "Он нашел тебя заблудшим и повел прямым путем.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6087, "text": "Он нашел тебя бедным и обогатил.", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6088, "text": "Посему не притесняй сироту!", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6089, "text": "И не гони просящего!", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6090, "text": "И возвещай о милости своего Господа.", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 93, "name": "سُورَةُ الضُّحَىٰ", "englishName": "Ad-Dhuhaa", "englishNameTranslation": "The Morning Hours", "revelationType": "Meccan", "numberOfAyahs": 11, "ayahs": [{"number": 6080, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6080.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6080.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6081, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6081.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6081.mp3"], "text": "وَٱلَّيْلِ إِذَا سَجَىٰ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6082, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6082.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6082.mp3"], "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 596, "ruku": 535, "hizbQuarter": 238, "sajda": false}, {"number": 6083, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6083.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6083.mp3"], "text": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱل