{"code": 200, "status": "OK", "data": [{"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "text": "بِأَييِّكُمُ ٱلْمَفْتُونُ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "text": "وَلَا يَسْتَثْنُونَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "text": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "text": "فَتَنَادَوْا۟ مُصْبِحِينَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "text": "بَلْ نَحْنُ مَحْرُومُونَ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "text": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "text": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "text": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "text": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "text": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "text": "وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "text": "Нун. Клянусь письменной тростью и тем, что они пишут!", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "text": "Ты по милости своего Господа не являешься одержимым.", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "text": "Воистину, награда твоя неиссякаема.", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "text": "Воистину, твой нрав превосходен.", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "text": "Ты увидишь, и они тоже увидят,", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "text": "кто из вас - бесноватый.", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "text": "Твой Господь лучше знает тех, кто сбился с Его пути, и лучше знает тех, кто следует прямым путем.", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "text": "Посему не повинуйся тем, кто считает истину ложью!", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "text": "Они хотели бы, чтобы ты был уступчив, и тогда они тоже стали бы уступчивы.", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "text": "Не повинуйся всякому расточителю клятв, презренному,", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "text": "хулителю, разносящему сплетни,", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "text": "скупящемуся на добро, преступнику, грешнику,", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "text": "жестокому, к тому же самозванцу,", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "text": "даже если он будет богат и будет иметь сыновей.", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "text": "Когда ему читают Наши аяты, он говорит: «Это - легенды древних народов!».", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "text": "Мы заклеймим его хобот (нос).", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "text": "Воистину, мы подвергли их испытанию, подобно тому, как мы подвергли испытанию владельцев сада, когда они поклялись, что утром они непременно сорвут их (плоды),", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "text": "но не сделали оговорки (не сказали: «Если того пожелает Аллах»).", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "text": "Ночью же, пока они спали, их сад поразила кара от твоего Господа.", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "text": "К утру сад был подобен мрачной ночи (был погублен).", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "text": "А на рассвете они стали звать друг друга:", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "text": "«Ступайте на вашу пашню, если вы хотите сорвать плоды!».", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "text": "Они отправились туда, разговаривая шепотом:", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "text": "«Не впускайте сегодня к себе бедняка».", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "text": "Они шли с твердым намерением и полагали, что у них достаточно сил.", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "text": "Когда же они увидели его, они сказали: «Мы сбились с пути!", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "text": "О нет! Мы лишились этого».", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "text": "Лучший из них сказал: «Разве я не говорил вам, что надо было прославить Аллаха?».", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "text": "Они сказали: «Пречист наш Господь! Мы были несправедливы».", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "text": "Они стали попрекать друг друга", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "text": "и сказали: «Горе нам! Мы преступили границы дозволенного.", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "text": "Быть может, Господь наш даст нам взамен нечто лучшее. Воистину, мы обращаемся к нашему Господу».", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "text": "Такими были мучения, а мучения в Последней жизни будут еще ужаснее! Если бы только они знали!", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "text": "Воистину, для богобоязненных у их Господа приготовлены Сады блаженства.", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "text": "Неужели Мы мусульман уравняем с грешниками?", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "text": "Что с вами? Как вы судите?", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "text": "Или у вас есть Писание, из которого вы узнали,", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "text": "что там у вас будет все, что вы выберете?", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "text": "Или у вас есть Наши клятвы, которые сохранятся до Дня воскресения, о том, что у вас будет все, что вы присудите?", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "text": "Спроси их, кто из них поручается за это?", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "text": "Или у них есть сотоварищи? Пусть же они приведут своих сотоварищей, если они говорят правду!", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "text": "В тот день, когда обнажится Голень Аллаха, их призовут пасть ниц, но они не смогут сделать этого.", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "text": "Их взоры потупятся, и унижение покроет их. А ведь их призывали пасть ниц, когда они пребывали в здравии.", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "text": "Оставь же Меня с теми, кто считает ложью это повествование. Мы завлечем их так, что они даже не осознают этого.", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "text": "Я даю им отсрочку, ведь хитрость Моя несокрушима.", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "text": "Или же ты просишь у них вознаграждения, и они обременены обязательствами?", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "text": "Или же они владеют сокровенным и записывают его?", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "text": "Потерпи же до решения твоего Господа и не уподобляйся человеку в рыбе (Йунусу), который обратился с мольбой вслух, сдерживая свою печаль.", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "text": "Если бы его не постигла милость Господа, то он был бы выброшен на открытую местность постыженным.", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "text": "Но его Господь избрал его и сделал одним из праведников.", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "text": "Воистину, неверующие готовы заставить тебя поскользнуться своими взглядами, когда они слышат Напоминание, и говорят: «Воистину, он - одержимый!».", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "text": "Но это - не что иное, как Напоминание для миров.", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 68, "name": "سُورَةُ القَلَمِ", "englishName": "Al-Qalam", "englishNameTranslation": "The Pen", "revelationType": "Meccan", "numberOfAyahs": 52, "ayahs": [{"number": 5272, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5272.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5272.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5273, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5273.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5273.mp3"], "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5274, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5274.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5274.mp3"], "text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5275, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5275.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5275.mp3"], "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5276, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5276.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5276.mp3"], "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5277, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5277.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5277.mp3"], "text": "بِأَييِّكُمُ ٱلْمَفْتُونُ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5278, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5278.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5278.mp3"], "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5279, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5279.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5279.mp3"], "text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5280, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5280.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5280.mp3"], "text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5281, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5281.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5281.mp3"], "text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5282, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5282.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5282.mp3"], "text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5283, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5283.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5283.mp3"], "text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5284, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5284.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5284.mp3"], "text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5285, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5285.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5285.mp3"], "text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5286, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5286.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5286.mp3"], "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 564, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5287, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5287.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5287.mp3"], "text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5288, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5288.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5288.mp3"], "text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5289, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5289.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5289.mp3"], "text": "وَلَا يَسْتَثْنُونَ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5290, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5290.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5290.mp3"], "text": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5291, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5291.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5291.mp3"], "text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5292, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5292.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5292.mp3"], "text": "فَتَنَادَوْا۟ مُصْبِحِينَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5293, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5293.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5293.mp3"], "text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5294, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5294.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5294.mp3"], "text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5295, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5295.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5295.mp3"], "text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5296, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5296.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5296.mp3"], "text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5297, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5297.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5297.mp3"], "text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5298, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5298.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5298.mp3"], "text": "بَلْ نَحْنُ مَحْرُومُونَ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5299, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5299.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5299.mp3"], "text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5300, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5300.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5300.mp3"], "text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5301, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5301.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5301.mp3"], "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5302, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5302.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5302.mp3"], "text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5303, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5303.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5303.mp3"], "text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5304, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5304.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5304.mp3"], "text": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 565, "ruku": 498, "hizbQuarter": 226, "sajda": false}, {"number": 5305, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5305.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5305.mp3"], "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5306, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5306.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5306.mp3"], "text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5307, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5307.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5307.mp3"], "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5308, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5308.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5308.mp3"], "text": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5309, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5309.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5309.mp3"], "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5310, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5310.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5310.mp3"], "text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5311, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5311.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5311.mp3"], "text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5312, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5312.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5312.mp3"], "text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ", "numberInSurah": 41, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5313, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5313.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5313.mp3"], "text": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ", "numberInSurah": 42, "juz": 29, "manzil": 7, "page": 565, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5314, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5314.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5314.mp3"], "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ", "numberInSurah": 43, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5315, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5315.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5315.mp3"], "text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "numberInSurah": 44, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5316, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5316.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5316.mp3"], "text": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ", "numberInSurah": 45, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5317, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5317.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5317.mp3"], "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ", "numberInSurah": 46, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5318, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5318.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5318.mp3"], "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ", "numberInSurah": 47, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5319, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5319.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5319.mp3"], "text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ", "numberInSurah": 48, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5320, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5320.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5320.mp3"], "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ", "numberInSurah": 49, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5321, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5321.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5321.mp3"], "text": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ", "numberInSurah": 50, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5322, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5322.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5322.mp3"], "text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ", "numberInSurah": 51, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}, {"number": 5323, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5323.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5323.mp3"], "text": "وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "numberInSurah": 52, "juz": 29, "manzil": 7, "page": 566, "ruku": 499, "hizbQuarter": 226, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}