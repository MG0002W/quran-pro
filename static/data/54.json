{"code": 200, "status": "OK", "data": [{"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "text": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "text": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "text": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "text": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "text": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "text": "خُشَّعًا أَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌۭ مُّنتَشِرٌۭ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "text": "مُّهْطِعِينَ إِلَى ٱلدَّاعِ ۖ يَقُولُ ٱلْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٌۭ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "text": "۞ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌۭ وَٱزْدُجِرَ", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "text": "فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ فَٱنتَصِرْ", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "text": "فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍۢ مُّنْهَمِرٍۢ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "text": "وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًۭا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍۢ قَدْ قُدِرَ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "text": "وَحَمَلْنَٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍۢ وَدُسُرٍۢ", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "text": "تَجْرِى بِأَعْيُنِنَا جَزَآءًۭ لِّمَن كَانَ كُفِرَ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةًۭ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "text": "كَذَّبَتْ عَادٌۭ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ رِيحًۭا صَرْصَرًۭا فِى يَوْمِ نَحْسٍۢ مُّسْتَمِرٍّۢ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "text": "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍۢ مُّنقَعِرٍۢ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "text": "كَذَّبَتْ ثَمُودُ بِٱلنُّذُرِ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "text": "فَقَالُوٓا۟ أَبَشَرًۭا مِّنَّا وَٰحِدًۭا نَّتَّبِعُهُۥٓ إِنَّآ إِذًۭا لَّفِى ضَلَٰلٍۢ وَسُعُرٍ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "text": "أَءُلْقِىَ ٱلذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌۭ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "text": "سَيَعْلَمُونَ غَدًۭا مَّنِ ٱلْكَذَّابُ ٱلْأَشِرُ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "text": "إِنَّا مُرْسِلُوا۟ ٱلنَّاقَةِ فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ وَٱصْطَبِرْ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "text": "وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ مُّحْتَضَرٌۭ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "text": "فَنَادَوْا۟ صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةًۭ وَٰحِدَةًۭ فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "text": "كَذَّبَتْ قَوْمُ لُوطٍۭ بِٱلنُّذُرِ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّآ ءَالَ لُوطٍۢ ۖ نَّجَّيْنَٰهُم بِسَحَرٍۢ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "text": "نِّعْمَةًۭ مِّنْ عِندِنَا ۚ كَذَٰلِكَ نَجْزِى مَن شَكَرَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "text": "وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا۟ بِٱلنُّذُرِ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "text": "وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابٌۭ مُّسْتَقِرٌّۭ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "text": "فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "text": "وَلَقَدْ جَآءَ ءَالَ فِرْعَوْنَ ٱلنُّذُرُ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "text": "كَذَّبُوا۟ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمْ أَخْذَ عَزِيزٍۢ مُّقْتَدِرٍ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "text": "أَكُفَّارُكُمْ خَيْرٌۭ مِّنْ أُو۟لَٰٓئِكُمْ أَمْ لَكُم بَرَآءَةٌۭ فِى ٱلزُّبُرِ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعٌۭ مُّنتَصِرٌۭ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "text": "سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ ٱلدُّبُرَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "text": "بَلِ ٱلسَّاعَةُ مَوْعِدُهُمْ وَٱلسَّاعَةُ أَدْهَىٰ وَأَمَرُّ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "text": "إِنَّ ٱلْمُجْرِمِينَ فِى ضَلَٰلٍۢ وَسُعُرٍۢ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "text": "يَوْمَ يُسْحَبُونَ فِى ٱلنَّارِ عَلَىٰ وُجُوهِهِمْ ذُوقُوا۟ مَسَّ سَقَرَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "text": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَٰهُ بِقَدَرٍۢ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "text": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "text": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "text": "وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "text": "وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "text": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "text": "Приблизился Час, и раскололся месяц.", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "text": "Когда они видят знамение, то отворачиваются и говорят: «Это - преходящее (или крепкое; или лживое) колдовство!».", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "text": "Они сочли лжецами посланников и потакали своим желаниям, но каждый поступок утвердится (творения получат вознаграждение за добро и наказание за зло).", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "text": "До них уже дошли известия, которые удерживали от неверия.", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "text": "Это является совершенной мудростью, но какую пользу приносят предостережения (или предостережения не принесли им никакой пользы)?", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "text": "Отвернись же от них. В тот день, когда глашатай призовет к неприятной вещи,", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "text": "они с униженными взорами выйдут из могил, словно рассеянная саранча.", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "text": "Они устремятся к глашатаю, и неверующие скажут: «Это - Тяжкий день!».", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "text": "До них счел лжецами посланников народ Нуха (Ноя). Они сочли лжецом Нашего раба и сказали: «Он - одержимый!». Они ругали его и угрожали ему.", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "text": "Тогда он воззвал к своему Господу: «Меня одолели. Помоги же мне!».", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "text": "Мы открыли врата неба, откуда стала изливаться вода,", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "text": "и разверзли землю, из которой забили ключи. Воды небес и земли слились для дела, которое было предопределено.", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "text": "Мы понесли его в ковчеге из досок и гвоздей.", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "text": "Ковчег поплыл у Нас на Глазах в воздаяние тому, в кого не уверовали (или тем, которые не уверовали).", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "text": "Мы оставили его (корабль или рассказ о Нухе) в качестве знамения. Но есть ли среди вас вспоминающие?", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "text": "Какими же были мучения от Меня и предостережения Мои!", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "text": "Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "text": "Адиты сочли лжецами посланников. Какими же были мучения от Меня и предостережения Мои!", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "text": "Мы наслали на них морозный (или завывающий) ветер в день, злосчастье которого продолжалось.", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "text": "Он вырывал людей, словно стволы выкорчеванных финиковых пальм.", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "text": "Какими же были мучения от Меня и предостережения Мои!", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "text": "Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "text": "Самудяне сочли ложью предостережения.", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "text": "Они сказали: «Неужели мы последуем за одним из нас? В этом случае мы окажемся в заблуждении и будем страдать (или отдалимся от истины).", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "text": "Неужели среди всех нас напоминание ниспослано только ему одному? О нет! Он - надменный лжец».", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "text": "Завтра они узнают, кто является надменным лжецом!", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "text": "Аллах сказал их пророку: «Мы посылаем верблюдицу для того, чтобы испытать их. Подожди же и будь терпелив.", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "text": "Сообщи им, что вода поделена между ними и верблюдицей. Пусть же они приходят попить каждый раз в отведенное для них время».", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "text": "Они позвали своего товарища, и тот схватил верблюдицу и перерезал ей поджилки.", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "text": "Какими же были мучения от Меня и предостережения Мои!", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "text": "Воистину, Мы наслали на них всего лишь один вопль, и они уподобились сену хозяина загона.", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "text": "Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "text": "Народ Лута (Лота) счел ложью предостережения.", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "text": "Мы наслали на них ураган с камнями, и только семью Лута (Лота) Мы спасли перед рассветом", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "text": "по милости от Нас. Так Мы воздаем тем, кто благодарен.", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "text": "Он предостерег их от Нашей Хватки, но они усомнились в его предостережениях.", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "text": "Они настойчиво требовали от него его гостей, и тогда Мы лишили их зрения. Вкусите же мучения от Меня и предостережения Мои!", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "text": "На утро их постигли неотвратимые мучения.", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "text": "Вкусите же мучения от Меня и предостережения Мои!", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "text": "Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "text": "Предостережения также явились к роду Фараона.", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "text": "Они сочли ложью все Наши знамения, и Мы схватили их Хваткой Могущественного, Всемогущего.", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "text": "Разве ваши неверующие лучше тех? Или же у вас есть неприкосновенность, упомянутая в Писаниях?", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "text": "Или же они говорят: «Мы являемся победоносной группой».", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "text": "Эта группа будет разбита, и они обратятся вспять!", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "text": "Час является назначенным для них сроком, и Час этот - самый тяжкий, самый горький.", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "text": "Воистину, грешники сбились с пути и страдают (или отдалились от истины).", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "text": "В тот день их ничком поволокут в Огонь: «Вкусите прикосновение Преисподней!».", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "text": "Воистину, Мы сотворили каждую вещь согласно предопределению.", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "text": "Мы повелеваем только один раз, и повеление исполняется в мгновение ока.", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "text": "Мы уже погубили подобных вам. Но есть ли среди вас вспоминающие?", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "text": "Все, что они совершили, есть в книгах деяний.", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "text": "Все малое и великое уже начертано.", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "text": "Воистину, богобоязненные пребудут в Райских садах и среди рек", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "text": "на седалище истины возле Всемогущего Властелина.", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 54, "name": "سُورَةُ القَمَرِ", "englishName": "Al-Qamar", "englishNameTranslation": "The Moon", "revelationType": "Meccan", "numberOfAyahs": 55, "ayahs": [{"number": 4847, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4847.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4847.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ", "numberInSurah": 1, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4848, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4848.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4848.mp3"], "text": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ", "numberInSurah": 2, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4849, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4849.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4849.mp3"], "text": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ", "numberInSurah": 3, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4850, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4850.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4850.mp3"], "text": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ", "numberInSurah": 4, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4851, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4851.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4851.mp3"], "text": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ", "numberInSurah": 5, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4852, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4852.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4852.mp3"], "text": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ", "numberInSurah": 6, "juz": 27, "manzil": 7, "page": 528, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4853, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4853.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4853.mp3"], "text": "خُشَّعًا أَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌۭ مُّنتَشِرٌۭ", "numberInSurah": 7, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4854, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4854.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4854.mp3"], "text": "مُّهْطِعِينَ إِلَى ٱلدَّاعِ ۖ يَقُولُ ٱلْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٌۭ", "numberInSurah": 8, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 211, "sajda": false}, {"number": 4855, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4855.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4855.mp3"], "text": "۞ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌۭ وَٱزْدُجِرَ", "numberInSurah": 9, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4856, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4856.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4856.mp3"], "text": "فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ فَٱنتَصِرْ", "numberInSurah": 10, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4857, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4857.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4857.mp3"], "text": "فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍۢ مُّنْهَمِرٍۢ", "numberInSurah": 11, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4858, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4858.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4858.mp3"], "text": "وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًۭا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍۢ قَدْ قُدِرَ", "numberInSurah": 12, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4859, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4859.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4859.mp3"], "text": "وَحَمَلْنَٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍۢ وَدُسُرٍۢ", "numberInSurah": 13, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4860, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4860.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4860.mp3"], "text": "تَجْرِى بِأَعْيُنِنَا جَزَآءًۭ لِّمَن كَانَ كُفِرَ", "numberInSurah": 14, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4861, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4861.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4861.mp3"], "text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةًۭ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 15, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4862, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4862.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4862.mp3"], "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 16, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4863, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4863.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4863.mp3"], "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 17, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4864, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4864.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4864.mp3"], "text": "كَذَّبَتْ عَادٌۭ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 18, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4865, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4865.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4865.mp3"], "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ رِيحًۭا صَرْصَرًۭا فِى يَوْمِ نَحْسٍۢ مُّسْتَمِرٍّۢ", "numberInSurah": 19, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4866, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4866.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4866.mp3"], "text": "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍۢ مُّنقَعِرٍۢ", "numberInSurah": 20, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4867, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4867.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4867.mp3"], "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 21, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4868, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4868.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4868.mp3"], "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 22, "juz": 27, "manzil": 7, "page": 529, "ruku": 463, "hizbQuarter": 212, "sajda": false}, {"number": 4869, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4869.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4869.mp3"], "text": "كَذَّبَتْ ثَمُودُ بِٱلنُّذُرِ", "numberInSurah": 23, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4870, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4870.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4870.mp3"], "text": "فَقَالُوٓا۟ أَبَشَرًۭا مِّنَّا وَٰحِدًۭا نَّتَّبِعُهُۥٓ إِنَّآ إِذًۭا لَّفِى ضَلَٰلٍۢ وَسُعُرٍ", "numberInSurah": 24, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4871, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4871.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4871.mp3"], "text": "أَءُلْقِىَ ٱلذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌۭ", "numberInSurah": 25, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4872, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4872.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4872.mp3"], "text": "سَيَعْلَمُونَ غَدًۭا مَّنِ ٱلْكَذَّابُ ٱلْأَشِرُ", "numberInSurah": 26, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4873, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4873.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4873.mp3"], "text": "إِنَّا مُرْسِلُوا۟ ٱلنَّاقَةِ فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ وَٱصْطَبِرْ", "numberInSurah": 27, "juz": 27, "manzil": 7, "page": 529, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4874, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4874.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4874.mp3"], "text": "وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ مُّحْتَضَرٌۭ", "numberInSurah": 28, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4875, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4875.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4875.mp3"], "text": "فَنَادَوْا۟ صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ", "numberInSurah": 29, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4876, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4876.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4876.mp3"], "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ", "numberInSurah": 30, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4877, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4877.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4877.mp3"], "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةًۭ وَٰحِدَةًۭ فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4878, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4878.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4878.mp3"], "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4879, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4879.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4879.mp3"], "text": "كَذَّبَتْ قَوْمُ لُوطٍۭ بِٱلنُّذُرِ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4880, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4880.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4880.mp3"], "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّآ ءَالَ لُوطٍۢ ۖ نَّجَّيْنَٰهُم بِسَحَرٍۢ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4881, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4881.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4881.mp3"], "text": "نِّعْمَةًۭ مِّنْ عِندِنَا ۚ كَذَٰلِكَ نَجْزِى مَن شَكَرَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4882, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4882.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4882.mp3"], "text": "وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا۟ بِٱلنُّذُرِ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4883, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4883.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4883.mp3"], "text": "وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4884, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4884.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4884.mp3"], "text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابٌۭ مُّسْتَقِرٌّۭ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4885, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4885.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4885.mp3"], "text": "فَذُوقُوا۟ عَذَابِى وَنُذُرِ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4886, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4886.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4886.mp3"], "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 530, "ruku": 464, "hizbQuarter": 212, "sajda": false}, {"number": 4887, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4887.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4887.mp3"], "text": "وَلَقَدْ جَآءَ ءَالَ فِرْعَوْنَ ٱلنُّذُرُ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4888, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4888.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4888.mp3"], "text": "كَذَّبُوا۟ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمْ أَخْذَ عَزِيزٍۢ مُّقْتَدِرٍ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4889, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4889.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4889.mp3"], "text": "أَكُفَّارُكُمْ خَيْرٌۭ مِّنْ أُو۟لَٰٓئِكُمْ أَمْ لَكُم بَرَآءَةٌۭ فِى ٱلزُّبُرِ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4890, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4890.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4890.mp3"], "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعٌۭ مُّنتَصِرٌۭ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4891, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4891.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4891.mp3"], "text": "سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ ٱلدُّبُرَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4892, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4892.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4892.mp3"], "text": "بَلِ ٱلسَّاعَةُ مَوْعِدُهُمْ وَٱلسَّاعَةُ أَدْهَىٰ وَأَمَرُّ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4893, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4893.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4893.mp3"], "text": "إِنَّ ٱلْمُجْرِمِينَ فِى ضَلَٰلٍۢ وَسُعُرٍۢ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4894, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4894.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4894.mp3"], "text": "يَوْمَ يُسْحَبُونَ فِى ٱلنَّارِ عَلَىٰ وُجُوهِهِمْ ذُوقُوا۟ مَسَّ سَقَرَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4895, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4895.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4895.mp3"], "text": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَٰهُ بِقَدَرٍۢ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 530, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4896, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4896.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4896.mp3"], "text": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌۭ كَلَمْحٍۭ بِٱلْبَصَرِ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4897, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4897.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4897.mp3"], "text": "وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍۢ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4898, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4898.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4898.mp3"], "text": "وَكُلُّ شَىْءٍۢ فَعَلُوهُ فِى ٱلزُّبُرِ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4899, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4899.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4899.mp3"], "text": "وَكُلُّ صَغِيرٍۢ وَكَبِيرٍۢ مُّسْتَطَرٌ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4900, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4900.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4900.mp3"], "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَهَرٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}, {"number": 4901, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4901.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4901.mp3"], "text": "فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍۢ مُّقْتَدِرٍۭ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 531, "ruku": 465, "hizbQuarter": 212, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}