{"code": 200, "status": "OK", "data": [{"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "text": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "text": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5975, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5976, "text": "لِّسَعْيِهَا رَاضِيَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5977, "text": "فِى جَنَّةٍ عَالِيَةٍۢ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5978, "text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5979, "text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5980, "text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5981, "text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5982, "text": "وَنَمَارِقُ مَصْفُوفَةٌۭ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5983, "text": "وَزَرَابِىُّ مَبْثُوثَةٌ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5984, "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5985, "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5986, "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5987, "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5988, "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5989, "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5990, "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5991, "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5992, "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5993, "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "text": "Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "text": "Одни лица в тот день будут унижены,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "text": "изнурены и утомлены.", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "text": "Они войдут в Огонь жаркий.", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "text": "Их будут поить из источника кипящего", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "text": "и кормить только ядовитыми колючками,", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "text": "от которых не поправляются и которые не утоляют голода.", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5975, "text": "Другие же лица в тот день будут радостны.", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5976, "text": "Они будут довольны своими стараниями", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5977, "text": "в Вышних садах.", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5978, "text": "Они не услышат там словоблудия.", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5979, "text": "Там есть источник текущий.", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5980, "text": "Там воздвигнуты ложа,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5981, "text": "расставлены чаши,", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5982, "text": "разложены подушки,", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5983, "text": "и разостланы ковры.", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5984, "text": "Неужели они не видят, как созданы верблюды,", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5985, "text": "как вознесено небо,", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5986, "text": "как водружены горы,", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5987, "text": "как распростерта земля?", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5988, "text": "Наставляй же, ведь ты - наставник,", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5989, "text": "и ты не властен над ними.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5990, "text": "А тех, кто отвернется и не уверует,", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5991, "text": "Аллах подвергнет величайшим мучениям.", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5992, "text": "К Нам они вернутся,", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5993, "text": "и затем Мы потребуем у них отчета.", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 88, "name": "سُورَةُ الغَاشِيَةِ", "englishName": "Al-Ghaashiya", "englishNameTranslation": "The Overwhelming", "revelationType": "Meccan", "numberOfAyahs": 26, "ayahs": [{"number": 5968, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5968.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5968.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5969, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5969.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5969.mp3"], "text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5970, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5970.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5970.mp3"], "text": "عَامِلَةٌۭ نَّاصِبَةٌۭ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5971, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5971.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5971.mp3"], "text": "تَصْلَىٰ نَارًا حَامِيَةًۭ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5972, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5972.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5972.mp3"], "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5973, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5973.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5973.mp3"], "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuarter": 237, "sajda": false}, {"number": 5974, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5974.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5974.mp3"], "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 592, "ruku": 530, "hizbQuart