{"code": 200, "status": "OK", "data": [{"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "text": "وَخَسَفَ ٱلْقَمَرُ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "text": "كَلَّا لَا وَزَرَ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "text": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5585, "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5586, "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5587, "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5588, "text": "أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5589, "text": "ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5590, "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5591, "text": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "text": "Нет, клянусь Днем воскресения!", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "text": "Клянусь душой попрекающей!", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "text": "Неужели человек полагает, что Мы не соберем его костей?", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "text": "Конечно! Мы способны восстановить даже кончики его пальцев (или сделать всего его пальцы одинаковыми, так что он не сможет пользоваться ими, как прежде).", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "text": "Но человек желает и впредь совершать грехи.", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "text": "Он спрашивает, когда же наступит День воскресения?", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "text": "Когда взор будет ошеломлен,", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "text": "луна затмится,", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "text": "а солнце и луна сойдутся.", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "text": "В тот день человек скажет: «Куда бежать?».", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "text": "О нет! Не будет убежища!", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "text": "В тот день возвращение будет к твоему Господу.", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "text": "В тот день человеку возвестят о том, что он совершил заранее и что оставил после себя.", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "text": "Но человек будет свидетельствовать против самого себя,", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "text": "даже если он будет оправдываться.", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "text": "Не шевели своим языком, повторяя его (Коран), чтобы поскорее запомнить.", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "text": "Нам надлежит собрать его и прочесть.", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "text": "Когда же Мы прочтем его, то читай его следом.", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "text": "Нам надлежит разъяснять его.", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "text": "Но нет! Вы любите жизнь ближнюю", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "text": "и пренебрегаете Последней жизнью.", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "text": "Одни лица в тот день будут сиять", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "text": "и взирать на своего Господа.", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "text": "Другие же лица в тот день будут омрачены.", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "text": "Они убедятся о том, что их поразит беда.", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "text": "Но нет! Когда душа достигнет ключицы,", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "text": "будет сказано: «Кто же прочтет заклинание?».", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "text": "Умирающий поймет, что наступило расставание.", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "text": "Голень сойдется с голенью (тяготы мирской жизни объединятся с тяготами последней жизни или голени человека будут сложены вместе в саване),", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "text": "и в тот день его пригонят к твоему Господу.", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "text": "Он не уверовал и не совершал намаз.", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "text": "Напротив, он счел это ложью и отвернулся,", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "text": "а затем горделиво отправился к своей семье.", "numberInSurah": 33, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5585, "text": "Горе тебе, горе!", "numberInSurah": 34, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5586, "text": "Еще раз горе тебе, горе!", "numberInSurah": 35, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5587, "text": "Неужели человек полагает, что он будет оставлен без присмотра?", "numberInSurah": 36, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5588, "text": "Разве он не был каплей из семени источаемого?", "numberInSurah": 37, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5589, "text": "Потом он превратился в сгусток крови, после чего Он создал его и придал ему соразмерный облик.", "numberInSurah": 38, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5590, "text": "Он сотворил из него чету: мужчину и женщину.", "numberInSurah": 39, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5591, "text": "Неужели Он не способен воскресить мертвых?", "numberInSurah": 40, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 75, "name": "سُورَةُ القِيَامَةِ", "englishName": "Al-Qiyaama", "englishNameTranslation": "The Resurrection", "revelationType": "Meccan", "numberOfAyahs": 40, "ayahs": [{"number": 5552, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5552.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5552.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ", "numberInSurah": 1, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5553, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5553.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5553.mp3"], "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ", "numberInSurah": 2, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5554, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5554.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5554.mp3"], "text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ", "numberInSurah": 3, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5555, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5555.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5555.mp3"], "text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ", "numberInSurah": 4, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5556, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5556.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5556.mp3"], "text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ", "numberInSurah": 5, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5557, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5557.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5557.mp3"], "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ", "numberInSurah": 6, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5558, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5558.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5558.mp3"], "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ", "numberInSurah": 7, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5559, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5559.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5559.mp3"], "text": "وَخَسَفَ ٱلْقَمَرُ", "numberInSurah": 8, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5560, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5560.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5560.mp3"], "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ", "numberInSurah": 9, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5561, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5561.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5561.mp3"], "text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ", "numberInSurah": 10, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5562, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5562.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5562.mp3"], "text": "كَلَّا لَا وَزَرَ", "numberInSurah": 11, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5563, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5563.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5563.mp3"], "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ", "numberInSurah": 12, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5564, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5564.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5564.mp3"], "text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ", "numberInSurah": 13, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5565, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5565.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5565.mp3"], "text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ", "numberInSurah": 14, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5566, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5566.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5566.mp3"], "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ", "numberInSurah": 15, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5567, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5567.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5567.mp3"], "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ", "numberInSurah": 16, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5568, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5568.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5568.mp3"], "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ", "numberInSurah": 17, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5569, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5569.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5569.mp3"], "text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ", "numberInSurah": 18, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5570, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5570.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5570.mp3"], "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ", "numberInSurah": 19, "juz": 29, "manzil": 7, "page": 577, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5571, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5571.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5571.mp3"], "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ", "numberInSurah": 20, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5572, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5572.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5572.mp3"], "text": "وَتَذَرُونَ ٱلْءَاخِرَةَ", "numberInSurah": 21, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5573, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5573.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5573.mp3"], "text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ", "numberInSurah": 22, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5574, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5574.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5574.mp3"], "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ", "numberInSurah": 23, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5575, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5575.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5575.mp3"], "text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ", "numberInSurah": 24, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5576, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5576.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5576.mp3"], "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ", "numberInSurah": 25, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5577, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5577.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5577.mp3"], "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ", "numberInSurah": 26, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5578, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5578.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5578.mp3"], "text": "وَقِيلَ مَنْ ۜ رَاقٍۢ", "numberInSurah": 27, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5579, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5579.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5579.mp3"], "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ", "numberInSurah": 28, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5580, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5580.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5580.mp3"], "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ", "numberInSurah": 29, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5581, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5581.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5581.mp3"], "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ", "numberInSurah": 30, "juz": 29, "manzil": 7, "page": 578, "ruku": 512, "hizbQuarter": 231, "sajda": false}, {"number": 5582, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5582.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5582.mp3"], "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ", "numberInSurah": 31, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5583, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5583.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5583.mp3"], "text": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ", "numberInSurah": 32, "juz": 29, "manzil": 7, "page": 578, "ruku": 513, "hizbQuarter": 231, "sajda": false}, {"number": 5584, "audio": "https://cdn.islamic.netw