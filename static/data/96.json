dn.islamic.network/quran/audio/128/ar.alafasy/6114.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6114.mp3"], "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6115, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6115.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6115.mp3"], "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6116, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6116.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6116.mp3"], "text": "عَبْدًا إِذَا صَلَّىٰٓ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6117, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6117.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6117.mp3"], "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6118, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6118.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6118.mp3"], "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6119, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6119.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6119.mp3"], "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6120, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6120.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6120.mp3"], "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6121, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6121.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6121.mp3"], "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6122, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6122.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6122.mp3"], "text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6123, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6123.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6123.mp3"], "text": "فَلْيَدْعُ نَادِيَهُۥ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6124, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6124.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6124.mp3"], "text": "سَنَدْعُ ٱلزَّبَانِيَةَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": false}, {"number": 6125, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6125.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/6125.mp3"], "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 597, "ruku": 538, "hizbQuarter": 239, "sajda": {"id": 15, "recommended": false, "obligatory": true}}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}