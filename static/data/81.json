{"code": 200, "status": "OK", "data": [{"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5804, "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5805, "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5806, "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5807, "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5808, "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5809, "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5816, "text": "ٱلْجَوَارِ ٱلْكُنَّسِ", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5817, "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5818, "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5819, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5820, "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5821, "text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5822, "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5823, "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5824, "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5825, "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5826, "text": "فَأَيْنَ تَذْهَبُونَ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5827, "text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5828, "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5829, "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "text": "Когда солнце будет свернуто (или потеряет свое сияние, или будет выброшено),", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "text": "когда падут звезды,", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "text": "когда горы будут сдвинуты с мест (или приведены в движение),", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5804, "text": "когда верблюдицы на десятом месяце беременности останутся без присмотра,", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5805, "text": "когда дикие звери будут собраны,", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5806, "text": "когда моря запылают (или переполнятся; или опустеют; или перемешаются; или станут красными),", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5807, "text": "когда души объединятся (праведники объединятся с праведниками, а грешники - с грешниками; или праведники соединятся с райскими гуриями, а неверующие - с дьяволами; или души соединятся с телами),", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5808, "text": "когда зарытую живьем спросят,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5809, "text": "за какой грех ее убили,", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "text": "когда свитки с деяниями рабов будут развернуты,", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "text": "когда небо будет сдернуто,", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "text": "когда Ад будет разожжен с новой силой,", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "text": "когда Рай будет приближен к праведникам,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "text": "тогда познает душа, что она принесла.", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "text": "Но нет! Клянусь телами небесными - отступающими,", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5816, "text": "передвигающимися и исчезающими!", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5817, "text": "Клянусь ночью, когда она наступила (или отступила)!", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5818, "text": "Клянусь рассветом, когда он забрезжил!", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5819, "text": "Это - слова благородного посланца,", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5820, "text": "обладателя силы при Владыке Трона, почитаемого,", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5821, "text": "которому там (на небесах) повинуются, доверенного.", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5822, "text": "Ваш товарищ (Мухаммад) не является одержимым.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5823, "text": "Он видел его (Джибрила) на ясном горизонте", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5824, "text": "и не скупится передать сокровенное.", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5825, "text": "Это - не речи дьявола изгнанного, побиваемого.", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5826, "text": "Куда же вы направляетесь?", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5827, "text": "Это - лишь Напоминание мирам,", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5828, "text": "тем из вас, кто желает следовать прямым путем.", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5829, "text": "Но вы не пожелаете этого, если этого не пожелает Аллах, Господь миров.", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 81, "name": "سُورَةُ التَّكۡوِيرِ", "englishName": "At-Takwir", "englishNameTranslation": "The Overthrowing", "revelationType": "Meccan", "numberOfAyahs": 29, "ayahs": [{"number": 5801, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5801.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5801.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5802, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5802.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5802.mp3"], "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5803, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafas