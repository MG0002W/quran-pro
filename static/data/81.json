dn.islamic.network/quran/audio/64/ar.alafasy/5809.mp3"], "text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5810, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5810.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5810.mp3"], "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5811, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5811.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5811.mp3"], "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5812, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5812.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5812.mp3"], "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5813, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5813.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5813.mp3"], "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5814, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5814.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5814.mp3"], "text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 586, "ruku": 523, "hizbQuarter": 234, "sajda": false}, {"number": 5815, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5815.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.al