{"code": 200, "status": "OK", "data": [{"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "text": "فَٱلْحَٰمِلَٰتِ وِقْرًۭا", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "text": "فَٱلْجَٰرِيَٰتِ يُسْرًۭا", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "text": "فَٱلْمُقَسِّمَٰتِ أَمْرًا", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "text": "إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "text": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "text": "إِنَّكُمْ لَفِى قَوْلٍۢ مُّخْتَلِفٍۢ", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "text": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "text": "قُتِلَ ٱلْخَرَّٰصُونَ", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "text": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍۢ سَاهُونَ", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "text": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "text": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "text": "ذُوقُوا۟ فِتْنَتَكُمْ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "text": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "text": "كَانُوا۟ قَلِيلًۭا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "text": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "text": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "text": "وَفِى ٱلْأَرْضِ ءَايَٰتٌۭ لِّلْمُوقِنِينَ", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "text": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "text": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "text": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "text": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "text": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا ۖ قَالَ سَلَٰمٌۭ قَوْمٌۭ مُّنكَرُونَ", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "text": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "text": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "text": "فَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٍۢ", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "text": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌۭ", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "text": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "text": "۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "text": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "text": "وَتَرَكْنَا فِيهَآ ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "text": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَٰنٍۢ مُّبِينٍۢ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "text": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ أَوْ مَجْنُونٌۭ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌۭ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "text": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "text": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "text": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍۢ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "text": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّٰعِقَةُ وَهُمْ يَنظُرُونَ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "text": "فَمَا ٱسْتَطَٰعُوا۟ مِن قِيَامٍۢ وَمَا كَانُوا۟ مُنتَصِرِينَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًۭا فَٰسِقِينَ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "text": "وَٱلسَّمَآءَ بَنَيْنَٰهَا بِأَيْي۟دٍۢ وَإِنَّا لَمُوسِعُونَ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "text": "وَٱلْأَرْضَ فَرَشْنَٰهَا فَنِعْمَ ٱلْمَٰهِدُونَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "text": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "text": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "text": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "text": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "text": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "text": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "text": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "text": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "text": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "text": "Клянусь рассеивающими прах!", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "text": "Клянусь несущими бремя!", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "text": "Клянусь плывущими легко!", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "text": "Клянусь распределяющими дела!", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "text": "Обещанное вам есть истина,", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "text": "и суд непременно наступит.", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "text": "Клянусь небом, обладающим прекрасным обликом (или небом, обладающим мощью; или небом со звездами)!", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "text": "Ваши (неверующих) слова противоречивы.", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "text": "Отвращен от него (Мухаммада или Корана) тот, кто был отвращен.", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "text": "Да будут убиты лжецы,", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "text": "которые окутаны невежеством и беспечны!", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "text": "Они спрашивают, когда же настанет День воздаяния?", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "text": "В тот день они будут гореть в Огне.", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "text": "Вкусите ваше наказание, которое вы торопили.", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "text": "Воистину, богобоязненные пребудут в Райских садах и среди источников,", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "text": "получая то, что даровал им их Господь. До этого они были творящими добро.", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "text": "Они спали лишь малую часть ночи,", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "text": "а перед рассветом они молили о прощении.", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "text": "Они выделяли известную долю своего имущества для просящих и обездоленных.", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "text": "На земле есть знамения для людей убежденных,", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "text": "а также в вас самих. Неужели вы не видите?", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "text": "На небе находится ваш удел и то, что вам обещано.", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "text": "Клянусь Господом неба и земли, что это является истиной, подобно тому, что вы обладаете даром речи.", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "text": "Дошел ли до тебя рассказ о почтенных гостях Ибрахима (Авраама)?", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "text": "Вот они вошли к нему и сказали: «Мир тебе!». Он сказал: «И вам мир, люди незнакомые!».", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "text": "Он направился к своей семье с опаской и принес жирного теленка.", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "text": "Он придвинул его к ним и сказал: «Не отведаете ли?».", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "text": "Он испугался их в душе, и тогда они сказали: «Не бойся». Они обрадовали его вестью о знающем мальчике.", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "text": "Его жена стала кричать и бить себя по лицу. Она сказала: «Старая бесплодная женщина!».", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "text": "Они сказали: «Так сказал твой Господь. Он - Мудрый, Знающий».", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "text": "Он сказал: «Какова же ваша миссия, о посланцы?».", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "text": "Они сказали: «Мы посланы к грешным людям,", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "text": "чтобы наслать на них каменья из глины,", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "text": "помеченные у твоего Господа для тех, кто излишествовал».", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "text": "Мы вывели оттуда всех уверовавших,", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "text": "но нашли там только один дом с мусульманами.", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "text": "Мы оставили там знамение для тех, которые боятся мучительных страданий.", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "text": "Знамение было и в рассказе о Мусе (Моисее). Вот Мы отправили его к Фараону с явным доводом.", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "text": "Он отвернулся в сторону (или вместе со своим окружением) и сказал: «Колдун или одержимый!».", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "text": "Мы схватили его вместе с войском и бросили их в море, и он был достоин порицания.", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "text": "Знамение было и в рассказе об адитах. Вот Мы наслали на них недобрый ветер.", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "text": "Он обращал в подобие праха все, на что налетал.", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "text": "Знамение было и в рассказе о самудянах. Им было сказано: «Пользуйтесь благами до определенного времени».", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "text": "Они ослушались веления своего Господа, и их поразило губительное наказание, пока они наблюдали за этим.", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "text": "Они не смогли даже подняться, и никто не помог им.", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "text": "Мы уничтожили народ Нуха (Ноя) еще раньше, ибо они были людьми нечестивыми.", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "text": "Мы воздвигли небо благодаря могуществу, и Мы его расширяем (или даруем пропитание; или обладаем мощью).", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "text": "Мы разостлали землю, и как же прекрасно Мы расстилаем!", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "text": "Мы сотворили все сущее парами, - быть может, вы помяните назидание.", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "text": "Скажи: «Бегите же к Аллаху. Воистину, я являюсь для вас предостерегающим и разъясняющим увещевателем от Него.", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "text": "Не поклоняйтесь наряду с Аллахом другому божеству. Воистину, я являюсь для вас предостерегающим и разъясняющим увещевателем от Него».", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "text": "Таким же образом, какой бы посланник ни приходил к их предшественникам, они обязательно говорили: «Он - колдун или одержимый!».", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "text": "Неужели они заповедали это друг другу? О нет! Они являются людьми, преступающими границы дозволенного.", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "text": "Отвратись же от них, и тебя не будут порицать.", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "text": "И напоминай, ибо напоминание приносит пользу верующим.", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "text": "Я сотворил джиннов и людей только для того, чтобы они поклонялись Мне.", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "text": "Я не хочу от них никакого удела и не хочу, чтобы они кормили Меня.", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "text": "Воистину, Аллах является Наделяющим уделом, Обладающим могуществом, Крепким.", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "text": "Воистину, тем, которые поступали несправедливо, уготована доля наказания, подобная доле их товарищей. Пусть же они не торопят Меня.", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "text": "Горе неверующим от того дня их, который им обещан!", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 51, "name": "سُورَةُ الذَّارِيَاتِ", "englishName": "Adh-Dhaariyat", "englishNameTranslation": "The Winnowing Winds", "revelationType": "Meccan", "numberOfAyahs": 60, "ayahs": [{"number": 4676, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4676.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4676.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا", "numberInSurah": 1, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4677, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4677.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4677.mp3"], "text": "فَٱلْحَٰمِلَٰتِ وِقْرًۭا", "numberInSurah": 2, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4678, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4678.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4678.mp3"], "text": "فَٱلْجَٰرِيَٰتِ يُسْرًۭا", "numberInSurah": 3, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4679, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4679.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4679.mp3"], "text": "فَٱلْمُقَسِّمَٰتِ أَمْرًا", "numberInSurah": 4, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4680, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4680.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4680.mp3"], "text": "إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ", "numberInSurah": 5, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4681, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4681.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4681.mp3"], "text": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ", "numberInSurah": 6, "juz": 26, "manzil": 7, "page": 520, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4682, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4682.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4682.mp3"], "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ", "numberInSurah": 7, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4683, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4683.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4683.mp3"], "text": "إِنَّكُمْ لَفِى قَوْلٍۢ مُّخْتَلِفٍۢ", "numberInSurah": 8, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4684, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4684.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4684.mp3"], "text": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ", "numberInSurah": 9, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4685, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4685.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4685.mp3"], "text": "قُتِلَ ٱلْخَرَّٰصُونَ", "numberInSurah": 10, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4686, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4686.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4686.mp3"], "text": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍۢ سَاهُونَ", "numberInSurah": 11, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4687, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4687.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4687.mp3"], "text": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ", "numberInSurah": 12, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4688, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4688.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4688.mp3"], "text": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ", "numberInSurah": 13, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4689, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4689.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4689.mp3"], "text": "ذُوقُوا۟ فِتْنَتَكُمْ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ", "numberInSurah": 14, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4690, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4690.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4690.mp3"], "text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ", "numberInSurah": 15, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4691, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4691.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4691.mp3"], "text": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ", "numberInSurah": 16, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4692, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4692.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4692.mp3"], "text": "كَانُوا۟ قَلِيلًۭا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ", "numberInSurah": 17, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4693, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4693.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4693.mp3"], "text": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ", "numberInSurah": 18, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4694, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4694.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4694.mp3"], "text": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ", "numberInSurah": 19, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4695, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4695.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4695.mp3"], "text": "وَفِى ٱلْأَرْضِ ءَايَٰتٌۭ لِّلْمُوقِنِينَ", "numberInSurah": 20, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4696, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4696.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4696.mp3"], "text": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ", "numberInSurah": 21, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4697, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4697.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4697.mp3"], "text": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ", "numberInSurah": 22, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4698, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4698.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4698.mp3"], "text": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ", "numberInSurah": 23, "juz": 26, "manzil": 7, "page": 521, "ruku": 455, "hizbQuarter": 208, "sajda": false}, {"number": 4699, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4699.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4699.mp3"], "text": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ", "numberInSurah": 24, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4700, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4700.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4700.mp3"], "text": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا ۖ قَالَ سَلَٰمٌۭ قَوْمٌۭ مُّنكَرُونَ", "numberInSurah": 25, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4701, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4701.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4701.mp3"], "text": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ", "numberInSurah": 26, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4702, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4702.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4702.mp3"], "text": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ", "numberInSurah": 27, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4703, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4703.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4703.mp3"], "text": "فَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٍۢ", "numberInSurah": 28, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4704, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4704.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4704.mp3"], "text": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌۭ", "numberInSurah": 29, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4705, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4705.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4705.mp3"], "text": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ", "numberInSurah": 30, "juz": 26, "manzil": 7, "page": 521, "ruku": 456, "hizbQuarter": 208, "sajda": false}, {"number": 4706, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4706.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4706.mp3"], "text": "۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ", "numberInSurah": 31, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4707, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4707.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4707.mp3"], "text": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ", "numberInSurah": 32, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4708, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4708.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4708.mp3"], "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ", "numberInSurah": 33, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4709, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4709.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4709.mp3"], "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ", "numberInSurah": 34, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4710, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4710.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4710.mp3"], "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ", "numberInSurah": 35, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4711, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4711.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4711.mp3"], "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ", "numberInSurah": 36, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4712, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4712.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4712.mp3"], "text": "وَتَرَكْنَا فِيهَآ ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ", "numberInSurah": 37, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4713, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4713.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4713.mp3"], "text": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَٰنٍۢ مُّبِينٍۢ", "numberInSurah": 38, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4714, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4714.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4714.mp3"], "text": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ أَوْ مَجْنُونٌۭ", "numberInSurah": 39, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4715, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4715.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4715.mp3"], "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌۭ", "numberInSurah": 40, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4716, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4716.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4716.mp3"], "text": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ", "numberInSurah": 41, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4717, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4717.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4717.mp3"], "text": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ", "numberInSurah": 42, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4718, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4718.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4718.mp3"], "text": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍۢ", "numberInSurah": 43, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4719, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4719.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4719.mp3"], "text": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّٰعِقَةُ وَهُمْ يَنظُرُونَ", "numberInSurah": 44, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4720, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4720.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4720.mp3"], "text": "فَمَا ٱسْتَطَٰعُوا۟ مِن قِيَامٍۢ وَمَا كَانُوا۟ مُنتَصِرِينَ", "numberInSurah": 45, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4721, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4721.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4721.mp3"], "text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًۭا فَٰسِقِينَ", "numberInSurah": 46, "juz": 27, "manzil": 7, "page": 522, "ruku": 456, "hizbQuarter": 209, "sajda": false}, {"number": 4722, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4722.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4722.mp3"], "text": "وَٱلسَّمَآءَ بَنَيْنَٰهَا بِأَيْي۟دٍۢ وَإِنَّا لَمُوسِعُونَ", "numberInSurah": 47, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4723, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4723.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4723.mp3"], "text": "وَٱلْأَرْضَ فَرَشْنَٰهَا فَنِعْمَ ٱلْمَٰهِدُونَ", "numberInSurah": 48, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4724, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4724.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4724.mp3"], "text": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ", "numberInSurah": 49, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4725, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4725.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4725.mp3"], "text": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 50, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4726, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4726.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4726.mp3"], "text": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ", "numberInSurah": 51, "juz": 27, "manzil": 7, "page": 522, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4727, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4727.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4727.mp3"], "text": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ", "numberInSurah": 52, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4728, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4728.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4728.mp3"], "text": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ", "numberInSurah": 53, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4729, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4729.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4729.mp3"], "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ", "numberInSurah": 54, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4730, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4730.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4730.mp3"], "text": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ", "numberInSurah": 55, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4731, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4731.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4731.mp3"], "text": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ", "numberInSurah": 56, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4732, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4732.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4732.mp3"], "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ", "numberInSurah": 57, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4733, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4733.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4733.mp3"], "text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ", "numberInSurah": 58, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4734, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4734.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4734.mp3"], "text": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ", "numberInSurah": 59, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}, {"number": 4735, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4735.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/4735.mp3"], "text": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ", "numberInSurah": 60, "juz": 27, "manzil": 7, "page": 523, "ruku": 457, "hizbQuarter": 209, "sajda": false}], "edition": {"identifier": "ar.alafasy", "language": "ar", "name": "مشاري العفاسي", "englishName": "Alafasy", "format": "audio", "type": "versebyverse", "direction": null}}]}