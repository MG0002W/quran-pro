{"code": 200, "status": "OK", "data": [{"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "text": "تَتْبَعُهَا ٱلرَّادِفَةُ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "text": "فَكَذَّبَ وَعَصَىٰ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "text": "فَحَشَرَ فَنَادَىٰ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5739, "text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5740, "text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5741, "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5742, "text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5743, "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5744, "text": "وَٱلْجِبَالَ أَرْسَىٰهَا", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5745, "text": "مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5746, "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5747, "text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5748, "text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5749, "text": "فَأَمَّا مَن طَغَىٰ", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5750, "text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5751, "text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5752, "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5753, "text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5754, "text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5755, "text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ", "numberInSurah": 43, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5756, "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ", "numberInSurah": 44, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5757, "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا", "numberInSurah": 45, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5758, "text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا", "numberInSurah": 46, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "quran-uthmani", "language": "ar", "name": "القرآن الكريم برسم العثماني (uthmani)", "englishName": "Uthmani", "format": "text", "type": "quran", "direction": "rtl"}}, {"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "text": "Клянусь исторгающими души неверующих жестоко!", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "text": "Клянусь извлекающими души верующих нежно!", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "text": "Клянусь плывущими стремительно,", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "text": "опережающими уверенно", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "text": "и исполняющими повеления!", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "text": "В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "text": "вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "text": "В тот день затрепещут сердца,", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "text": "а их взоры будут смиренны.", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "text": "Они говорят: «Неужели мы вернемся в прежнее состояние", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "text": "после того, как станем истлевшими костями?!».", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "text": "Они говорят: «Если так, то это - невыгодное возвращение!».", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "text": "Но раздастся лишь один глас,", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "text": "и все они окажутся на поверхности земли.", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "text": "Дошел ли до тебя рассказ о Мусе (Моисее)?", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "text": "Вот Господь его воззвал к нему в священной долине Тува (Това):", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "text": "«Ступай к Фараону, ибо он преступил границы дозволенного,", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "text": "и скажи: «Не следует ли тебе очиститься?", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "text": "Я укажу тебе путь к твоему Господу, и ты станешь богобоязнен»».", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "text": "Он показал ему величайшее знамение,", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "text": "но тот счел его ложью и ослушался,", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "text": "а потом отвернулся, принявшись усердствовать.", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "text": "Он собрал толпу и громко воззвал,", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "text": "и сказал: «Я - ваш всевышний господь!».", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "text": "Тогда Аллах подверг его наказанию как в Последней жизни, так и в первой жизни.", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "text": "Воистину, в этом было назидание для тех, кто богобоязнен.", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5739, "text": "Вас ли труднее создать или небо? Он воздвиг его,", "numberInSurah": 27, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5740, "text": "поднял его своды и сделал его совершенным.", "numberInSurah": 28, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5741, "text": "Он сделал темной ночь его (неба) и вывел его утреннюю зарю.", "numberInSurah": 29, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5742, "text": "После этого Он распростер землю,", "numberInSurah": 30, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5743, "text": "вывел из нее воду и пастбища", "numberInSurah": 31, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5744, "text": "и утвердил на ней горы", "numberInSurah": 32, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5745, "text": "на пользу вам и вашему скоту.", "numberInSurah": 33, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5746, "text": "Когда же наступит Величайшее бедствие (День воскресения),", "numberInSurah": 34, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5747, "text": "в тот день человек вспомнит о том, в чем он усердствовал,", "numberInSurah": 35, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5748, "text": "и Ад будет ясно виден тем, кто будет видеть.", "numberInSurah": 36, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5749, "text": "Тому, кто преступил границы дозволенного", "numberInSurah": 37, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5750, "text": "и отдал предпочтение мирской жизни,", "numberInSurah": 38, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5751, "text": "пристанищем будет Ад.", "numberInSurah": 39, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5752, "text": "Тому же, кто боялся предстать перед своим Господом и удерживал себя от страстей,", "numberInSurah": 40, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5753, "text": "пристанищем будет Рай.", "numberInSurah": 41, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5754, "text": "Тебя спрашивают о Часе: «Когда же он настанет?».", "numberInSurah": 42, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5755, "text": "К чему тебе упоминать об этом?", "numberInSurah": 43, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5756, "text": "Только твой Господь ведает об этом.", "numberInSurah": 44, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5757, "text": "Воистину, ты - всего лишь предостерегающий увещеватель для тех, кто опасается этого.", "numberInSurah": 45, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}, {"number": 5758, "text": "В тот день, когда они увидят его, им покажется, что они провели в этом мире лишь послеполуденные часы или утро.", "numberInSurah": 46, "juz": 30, "manzil": 7, "page": 584, "ruku": 521, "hizbQuarter": 233, "sajda": false}], "edition": {"identifier": "ru.kuliev", "language": "ru", "name": "Кулиев", "englishName": "Elmir Kuliev", "format": "text", "type": "translation", "direction": "ltr"}}, {"number": 79, "name": "سُورَةُ النَّازِعَاتِ", "englishName": "An-Naazi'aat", "englishNameTranslation": "Those who drag forth", "revelationType": "Meccan", "numberOfAyahs": 46, "ayahs": [{"number": 5713, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5713.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5713.mp3"], "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا", "numberInSurah": 1, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5714, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5714.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5714.mp3"], "text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا", "numberInSurah": 2, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5715, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5715.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5715.mp3"], "text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا", "numberInSurah": 3, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5716, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5716.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5716.mp3"], "text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا", "numberInSurah": 4, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5717, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5717.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5717.mp3"], "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا", "numberInSurah": 5, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5718, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5718.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5718.mp3"], "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ", "numberInSurah": 6, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5719, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5719.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5719.mp3"], "text": "تَتْبَعُهَا ٱلرَّادِفَةُ", "numberInSurah": 7, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5720, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5720.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5720.mp3"], "text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ", "numberInSurah": 8, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5721, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5721.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5721.mp3"], "text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ", "numberInSurah": 9, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5722, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5722.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5722.mp3"], "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ", "numberInSurah": 10, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5723, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5723.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5723.mp3"], "text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ", "numberInSurah": 11, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5724, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5724.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5724.mp3"], "text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ", "numberInSurah": 12, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5725, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5725.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5725.mp3"], "text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ", "numberInSurah": 13, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5726, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5726.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5726.mp3"], "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ", "numberInSurah": 14, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5727, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5727.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5727.mp3"], "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ", "numberInSurah": 15, "juz": 30, "manzil": 7, "page": 583, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5728, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5728.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5728.mp3"], "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى", "numberInSurah": 16, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5729, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5729.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5729.mp3"], "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ", "numberInSurah": 17, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5730, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5730.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5730.mp3"], "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ", "numberInSurah": 18, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5731, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5731.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5731.mp3"], "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ", "numberInSurah": 19, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5732, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5732.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5732.mp3"], "text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ", "numberInSurah": 20, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5733, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5733.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5733.mp3"], "text": "فَكَذَّبَ وَعَصَىٰ", "numberInSurah": 21, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5734, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5734.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5734.mp3"], "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ", "numberInSurah": 22, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5735, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5735.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5735.mp3"], "text": "فَحَشَرَ فَنَادَىٰ", "numberInSurah": 23, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5736, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5736.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5736.mp3"], "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ", "numberInSurah": 24, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5737, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5737.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5737.mp3"], "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ", "numberInSurah": 25, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "hizbQuarter": 233, "sajda": false}, {"number": 5738, "audio": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5738.mp3", "audioSecondary": ["https://cdn.islamic.network/quran/audio/64/ar.alafasy/5738.mp3"], "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ", "numberInSurah": 26, "juz": 30, "manzil": 7, "page": 584, "ruku": 520, "